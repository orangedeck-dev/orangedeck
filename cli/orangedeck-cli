class Fehler(Exception):
    def __init__(self, text, code=1):
        super().__init__(text)
        self.code = code


class DienstFehlt(Exception):
    pass


def dienst_adresse():
    addr = os.environ.get("ORANGEDECK_ADDR", "127.0.0.1")
    # Lauscht der Dienst auf allen Schnittstellen, erreicht man ihn lokal
    # trotzdem ueber die Loopback-Adresse.
    if addr in ("", "0.0.0.0", "::"):
        addr = "127.0.0.1"
    return addr, int(os.environ.get("ORANGEDECK_PORT", "21021"))


def dienst_json(pfad, frist):
    addr, port = dienst_adresse()
    verb = http.client.HTTPConnection(addr, port, timeout=frist)
    try:
        verb.request("GET", pfad)
        antwort = verb.getresponse()
        if antwort.status != 200:
            raise DienstFehlt("HTTP %d" % antwort.status)
        return json.loads(antwort.read().decode())
    except (OSError, http.client.HTTPException, ValueError) as e:
        raise DienstFehlt(str(e))
    finally:
        verb.close()


def dienst_zustand():
    # 300 ms fuer /health: ein abgelehnter Anschluss kommt ohnehin sofort,
    # und wer den Dienst nicht hat, soll auf den Rueckfall nicht warten.
    if not dienst_json("/health", 0.3).get("ok"):
        raise DienstFehlt("health")
    return dienst_json("/state", 2)


def einstellungen():
    """host/scheme aus sources.json, wie beim Dienst -- eine eigene
    mempool-Instanz gilt dann auch hier."""
    pfad = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                        "orangedeck", "sources.json")
    try:
        with open(pfad) as f:
            cfg = json.load(f) or {}
    except (OSError, ValueError):
        cfg = {}
    host = cfg.get("host") or os.environ.get("ORANGEDECK_HOST") or "mempool.space"
    schema = cfg.get("scheme") or os.environ.get("ORANGEDECK_SCHEME") or "https"
    return host, schema


class Speicher:
    """Zwischenspeicher mit Dateisperre und Pause.

    **Die Sperre** sorgt dafuer, dass drei Leistenmodule, die im selben Moment
    starten, nur **eine** Anfrage ausloesen: der zweite wartet und findet die
    frische Antwort des ersten vor.

    **Die Pause** steht in einer Datei, nicht im Speicher. Scheitert eine
    Anfrage, warten auch alle folgenden Aufrufe -- 30 s, dann doppelt so lange,
    hoechstens 15 min. Ein Befehl, der jede Minute neu startet, wuerde sonst
    jede Minute wieder anklopfen. `bitfeed` im Direktbezug schreibt in dieselbe
    Datei."""

    def __init__(self):
        basis = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
        self.ordner = os.path.join(basis, "orangedeck-cli")
        os.makedirs(self.ordner, exist_ok=True)
        self.host, self.schema = einstellungen()

    def _datei(self, name):
        return os.path.join(self.ordner, name + ".json")

    def _lesen(self, name):
        try:
            with open(self._datei(name)) as f:
                return json.load(f)
        except (OSError, ValueError):
            return None

    def _schreiben(self, name, inhalt):
        tmp = self._datei(name) + ".tmp"
        with open(tmp, "w") as f:
            json.dump(inhalt, f)
        os.replace(tmp, self._datei(name))

    def _holen(self, pfad, frist=10):
        import urllib.error
        import urllib.request
        url = "%s://%s/api%s" % (self.schema, self.host, pfad)
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        try:
            with urllib.request.urlopen(req, timeout=frist) as r:
                return json.loads(r.read().decode())
        except urllib.error.HTTPError as e:
            # 404 ist ein Fehler hier im Programm, keine Ueberlastung dort.
            if e.code == 404:
                raise Fehler(t("netz", "HTTP 404 " + pfad))
            raise
        # Alles andere -- 429, 5xx, Zeitueberschreitung, TLS -- faengt feld().

    def pausiert_bis(self):
        return (self._lesen("_pause") or {}).get("bis", 0)

    def fehlschlag(self, grund):
        pause = self._lesen("_pause") or {}
        stufe = pause.get("stufe", 0) + 1
        warten = min(PAUSE_MAX, 30 * 2 ** (stufe - 1))
        self._schreiben("_pause", {"bis": time.time() + warten, "stufe": stufe, "grund": grund})
        return warten

    def erfolg(self):
        try:
            os.remove(self._datei("_pause"))
        except OSError:
            pass

    def feld(self, name, pfad, umformen):
        """(Daten, Alter in s oder None bei frisch geholt)."""
        with open(os.path.join(self.ordner, ".sperre"), "w") as sperre:
            fcntl.flock(sperre, fcntl.LOCK_EX)
            jetzt = time.time()
            vorrat = self._lesen(name)
            if vorrat and jetzt - vorrat["t"] < TTL[name]:
                return vorrat["daten"], None

            pause = self._lesen("_pause") or {}
            if jetzt < pause.get("bis", 0):
                if vorrat:
                    return vorrat["daten"], jetzt - vorrat["t"]
                raise Fehler(t("pause", pause.get("grund", "?"), dauer(pause["bis"] - jetzt)), 4)

            try:
                daten = umformen(self._holen(pfad))
            except Fehler:
                raise
            except Exception as e:
                grund = str(e) or e.__class__.__name__
                self.fehlschlag(grund)
                if vorrat:
                    return vorrat["daten"], jetzt - vorrat["t"]
                raise Fehler(t("netz", grund), 4)

            if pause:
                self.erfolg()
            self._schreiben(name, {"t": jetzt, "daten": daten})
            return daten, None

    def blockkacheln(self, block_id):
        """Die Kacheln eines Blocks, einmal geholt und behalten -- ein
        bestaetigter Block aendert sich nicht, und die Zusammenfassung sind
        rund 700 kB. Ein Neustart von bitfeed im selben Block fragt nicht
        noch einmal."""
        name = "block-" + block_id[-16:]
        vorrat = self._lesen(name)
        if vorrat:
            return vorrat
        txs = self._holen("/v1/block/%s/summary" % block_id, frist=40)
        daten = kacheln_aus_summary(txs)
        self._schreiben(name, daten)
        # Nur die letzten paar Bloecke aufheben.
        alte = sorted((f for f in os.listdir(self.ordner) if f.startswith("block-")),
                      key=lambda f: os.path.getmtime(os.path.join(self.ordner, f)))
        for f in alte[:-4]:
            try:
                os.remove(os.path.join(self.ordner, f))
            except OSError:
                pass
        return daten


# Wie der Dienst die Antworten von mempool.space auf seine Felder abbildet --
# poll_rest(), poll_slow() und Feed.set_tip() in daemon/orangedeck. Hier
# dieselben Namen, damit ein Befehl nicht merkt, woher die Zahlen kommen.
#
# **Ein Unterschied bleibt, und er liegt bei mempool.space:** der Dienst
# bekommt die Gebuehren ueber den WebSocket mit Nachkommastellen (1,51 / 0,94),
# `/v1/fees/recommended` liefert sie gerundet (2 / 1). Am 12.09.2026 beide
# nebeneinander gesehen.

def _tip(bloecke):
    b = (bloecke or [{}])[0]
    ex = b.get("extras") or {}
    return {
        "height": int(b.get("height") or 0),
        "id": b.get("id") or "",
        "time": int(b.get("timestamp") or 0),
        "nTx": int(b.get("tx_count") or 0),
        "size": int(b.get("size") or 0),
        "medianFee": round(float(ex.get("medianFee") or 0), 2),
        "totalFees": int(ex.get("totalFees") or 0),
        "reward": int(ex.get("reward") or 0),
        "pool": (ex.get("pool") or {}).get("name") or "",
