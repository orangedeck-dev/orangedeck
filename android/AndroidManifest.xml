<?xml version="1.0"?>
<!-- Eigenes Android-Manifest statt des von Qt erzeugten.
     Sobald QT_ANDROID_PACKAGE_SOURCE_DIR gesetzt ist, nimmt androiddeployqt
     diese Datei. Der Grund, sie ueberhaupt zu haben, sind die Verknuepfungen
     unten; zwei Dinge fallen dabei gleich mit an.

     **Der Paketname ist derselbe wie ueberall sonst**, und das war er
     nicht immer. Qt erzeugte zuerst `org.qtproject.example.orangedeck_app`
     — Qts Beispielname, den das APK bis zum 05.09.2026 wirklich trug.

     Danach hiess er kurz `store.rebel.orangedeck`, und dahinter stand ein
     echter Regelkonflikt: die Flatpak-Kennung war aus der Domain
     `21rebel.store` gebildet, und Flathub verlangt fuer ein Segment mit
     fuehrender Ziffer einen Unterstrich (`store._21rebel.orangedeck`).
     Android verlangt das Gegenteil — "each segment must start with a
     letter" — und lehnt genau das ab. Zwei Identitaeten fuer eine Anwendung.

     Aufgeloest hat das nicht ein Kniff, sondern eine eigene Domain:
     `orangedeck.dev` kennt keine fuehrende Ziffer, also erfuellt
     `dev.orangedeck.OrangeDeck` beide Regelwerke zugleich. Dieselbe
     Zeichenkette steht seither im Flatpak, im APK, in der .desktop-Datei und
     in der Compositor-Regel.

     **Kein WRITE_EXTERNAL_STORAGE.** Qt setzt es in der Vorlage. Die
     Anwendung ist ein Betrachter und fasst nichts auf dem Geraet an; eine
     Berechtigung, die niemand braucht, faellt weg. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.orangedeck.OrangeDeck"
    android:installLocation="auto"
    android:versionCode="16"
    android:versionName="0.2.13">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true" />
    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="true"
        android:fullBackupOnly="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name="org.qtproject.qt.android.bindings.QtActivity"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Die Verknuepfungen je Ansicht. Sie erscheinen beim langen
                 Druck auf das Symbol und lassen sich von dort auf den
                 Startbildschirm ziehen. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <meta-data
                android:name="android.app.lib_name"
                android:value="orangedeck-app" />

            <meta-data
                android:name="android.app.arguments"
                android:value="" />
        </activity>

        <!-- **Die Homescreen-Widgets.** Sie sind etwas voellig anderes als die
             Verknuepfungen oben: eine Verknuepfung startet die Anwendung, ein
             Widget zeichnet der Systemprozess des Starters selbst, ueber
             RemoteViews. Deshalb Java unter `src/` und kein QML; die
             Begruendung steht ausfuehrlich in `DeckWidget.java`.

             `android:exported="true"` ist Pflicht: den Rundruf
             APPWIDGET_UPDATE schickt das System, also ein fremder Prozess.
             Ohne das Kennzeichen bleibt das Widget in der Auswahlliste des
             Starters unsichtbar.

             Vier Empfaenger, weil ein Widget im Starter ueber seine Klasse
             ausgewaehlt wird. Die Arbeit steckt in der gemeinsamen
             Oberklasse. -->
        <receiver
            android:name=".WidgetUhr"
            android:label="@string/widget_uhr"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_uhr" />
        </receiver>

        <receiver
            android:name=".WidgetMempool"
            android:label="@string/widget_mempool"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mempool" />
        </receiver>

        <receiver
            android:name=".WidgetKurs"
            android:label="@string/widget_kurs"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_kurs" />
        </receiver>

        <receiver
            android:name=".WidgetUhrGross"
            android:label="@string/widget_uhr_gross"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_uhr_gross" />
        </receiver>

        <receiver
            android:name=".WidgetMiner"
            android:label="@string/widget_miner"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_miner" />
        </receiver>

        <receiver
            android:name=".WidgetNetz"
            android:label="@string/widget_netz"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_netz" />
        </receiver>

        <receiver
            android:name=".WidgetNetzGross"
            android:label="@string/widget_netz"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_netz_gross" />
        </receiver>

        <receiver
            android:name=".WidgetKursGross"
            android:label="@string/widget_kurs"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_kurs_gross" />
        </receiver>

        <receiver
            android:name=".WidgetMempoolGross"
            android:label="@string/widget_mempool"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mempool_gross" />
        </receiver>

        <receiver
            android:name=".WidgetMinerGross"
            android:label="@string/widget_miner"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_miner_gross" />
        </receiver>

        <!-- **Der zweite Versuch eines Widgets** (WidgetNachholen.java).
             BIND_JOB_SERVICE ist Pflicht: nur das System darf den Job
             starten. Nicht exportiert, niemand sonst ruft ihn. -->
        <service
            android:name=".WidgetNachholen"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qtprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/qtprovider_paths" />
        </provider>
    </application>
</manifest>
