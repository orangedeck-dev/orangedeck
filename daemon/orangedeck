class Market:
    """Die Trades aller Boersen zusammen: das Band, die Zaehlung, und ob
    gerade jemand hinsieht."""

    def __init__(self):
        self.lock = threading.Lock()
        self.letzte_abfrage = 0.0
        self.online = {}          # Boersenkennung -> True/False
        self.trades = 0
        # Die letzten Trades einzeln, fuer das Band unter dem Graphen.
        # **Mit laufender Nummer**: die Oberflaeche fragt `seit` und bekommt
        # nur, was seitdem dazukam -- wie beim Zustand. Alles andere waere bei
        # hunderten Trades je Sekunde Unfug.
        self.band = collections.deque(maxlen=MARKET_TAPE_KEEP)
        self.band_nr = 0

    def add(self, ts, preis, menge, kauf, quelle=""):
        wert = preis * menge
        with self.lock:
            # Ins Band nur, was auch etwas bedeutet. Ohne Schwelle waere es
            # eine Wand aus Zehn-Dollar-Zeilen, durch die niemand sieht.
            if wert >= MARKET_TAPE_MIN:
                self.band_nr += 1
                self.band.append([self.band_nr, round(ts, 2), round(preis, 2),
                                  round(wert), 1 if kauf else 0, quelle])
            self.trades += 1

    def gefragt(self):
        """Jede Abfrage haelt die Stroeme am Leben."""
        self.letzte_abfrage = time.time()

    def erwuenscht(self):
        return time.time() - self.letzte_abfrage < MARKET_LINGER

    def band_seit(self, nr, hoechstens=120):
        """Die Trades, die seit `nr` dazukamen -- juengste zuletzt."""
        with self.lock:
            neu = [t for t in self.band if t[0] > nr]
            letzte = self.band[-1][0] if self.band else 0
        return neu[-hoechstens:], letzte


