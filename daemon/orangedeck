def compress_projected(index, rows):
    """Bereitet die Transaktionsliste eines geplanten Blocks auf.

    Der Server schickt sie in Kurzform, Reihenfolge wie im Original
    (`uncompressTx`): [txid, fee, vsize, value, rate, flags, time]. Aufbereitet
    wird genau wie bei einem bestaetigten Block -- zwei Ziffern je Transaktion
    plus die Angaben fuer den Tooltip."""
    step = max(1, len(rows) // MAX_TILES + (1 if len(rows) % MAX_TILES else 0))
    tiles, details = [], []
    total_value = total_fee = 0
    total_vsize = 0.0
    for r in rows:
        total_fee += int(r[1] or 0)
        total_vsize += float(r[2] or 0)
        total_value += int(r[3] or 0)
    kinds = []
    for r in rows[::step]:
        tiles.append("%d%d" % (tile_size(r[3]), fee_bucket(r[4])))
        # Die Kurzform ist [txid, fee, vsize, value, rate, flags, time]
        kinds.append("%d" % tx_kind(r[5] if len(r) > 5 else 0))
        details.append([r[0], round(float(r[2] or 0), 2), int(r[1] or 0),
                        int(r[3] or 0), round(float(r[4] or 0), 3)])
    return {
        "index": index,
        "count": len(rows),
        "totalValue": total_value,
        "sumFees": total_fee,
        "avgFeeRate": round(total_fee / total_vsize, 3) if total_vsize else 0,
        "tileStep": step,
        "tiles": "".join(tiles),
        "types": "".join(kinds),
        "txs": details,
        "ts": round(time.time(), 2),
    }


def compress_rows(rows):
    """Kachelziffern und Angaben fuer eine Handvoll Transaktionen, ohne
    Ausduennen -- fuer die Aenderungsmeldung."""
    tiles, kinds, details = [], [], []
    for r in rows:
        tiles.append("%d%d" % (tile_size(r[3]), fee_bucket(r[4])))
        kinds.append("%d" % tx_kind(r[5] if len(r) > 5 else 0))
        details.append([r[0], round(float(r[2] or 0), 2), int(r[1] or 0),
                        int(r[3] or 0), round(float(r[4] or 0), 3)])
    return "".join(tiles), "".join(kinds), details


def projected_delta(feed, idx, base, count):
    """Was sich seit Nummer `base` geaendert hat.

    Gibt None zurueck, wenn sich das nicht sauber beantworten laesst -- dann
    muss die Vollform her. Drei Faelle: die Liste ist ausgeduennt (dann passen
    einzelne Aenderungen nicht mehr dazu), der Rueckstand ist groesser als das
    Aenderungsbuch, oder die Aenderungen sind zusammen laenger als die
    Vollform."""
    if count > MAX_TILES:
        return None
    log = feed.projected_log.get(idx) or []
    seq = feed.projected_seq.get(idx, 0)
    if base > seq:
        return None                       # Stand aus einem frueheren Lauf
    if base < seq and (not log or log[0][0] > base + 1):
        return None                       # Luecke im Aenderungsbuch

    zugang, abgang, weg = {}, [], set()
    for nr, a, r in log:
        if nr <= base:
            continue
        for txid in r:
            zugang.pop(txid, None)
            if txid not in weg:
                weg.add(txid)
                abgang.append(txid)
        for row in a:
            zugang[row[0]] = row
            if row[0] in weg:
                weg.discard(row[0])
                abgang.remove(row[0])

    if len(zugang) + len(abgang) > count * 0.6:
        return None

    tiles, kinds, details = compress_rows(sorted(zugang.values(),
                                                 key=lambda r: -(r[4] or 0)))
    return {
        "index": idx,
        "seq": seq,
        "full": False,
        "count": count,
        "tiles": tiles,
        "types": kinds,
        "txs": details,
        "removed": abgang,
        "changedAt": round(feed.projected_at.get(idx, 0), 2),
        "ts": round(time.time(), 2),
    }


def handle(feed, msg):
    if "mempoolInfo" in msg:
        feed.set_mempool(msg["mempoolInfo"])
    if "transactions" in msg:
        feed.add_txs(msg["transactions"] or [])
    if "mempool-blocks" in msg:
        feed.set_next_block(msg["mempool-blocks"] or [])
    if "fees" in msg:
        f = msg["fees"] or {}
        feed.fees = {
            "fastest": round(float(f.get("fastestFee") or 0), 2),
            "halfHour": round(float(f.get("halfHourFee") or 0), 2),
            "hour": round(float(f.get("hourFee") or 0), 2),
            "economy": round(float(f.get("economyFee") or 0), 2),
            "minimum": round(float(f.get("minimumFee") or 0), 2),
        }
        feed.dirty = True
    if "vBytesPerSecond" in msg:
        feed.vbps = int(msg["vBytesPerSecond"] or 0)
        feed.dirty = True
    if "conversions" in msg:
        # Der Server liefert sieben Waehrungen mit -- fuenf davon wurden bisher
        # weggeworfen. Sie kosten nichts extra und ersparen der Oberflaeche
        # jede eigene Umrechnung.
        c = msg["conversions"] or {}
        feed.price = {k.lower(): c.get(k) for k in CURRENCIES if c.get(k)}
        feed.dirty = True
    if "blocks" in msg and msg["blocks"]:
        feed.set_tip(msg["blocks"][-1])
    if "block" in msg and msg["block"]:
        feed.set_tip(msg["block"], is_new=True)


def handle_projected(feed, p):
    """Antwort auf `track-mempool-block`.

    Zuerst kommt die Vollform, danach nur noch Aenderungen. Solange jemand
    hinsieht, werden sie mitgefuehrt -- so bleibt die Ansicht lebendig, ohne
    die Liste immer wieder ganz zu holen. Gemessen: die Vollform ist rund
    430 kB, die Aenderungen kosten 7,8 kB/s."""
    try:
        idx = int(p.get("index"))
    except (TypeError, ValueError):
        return False

    rows = p.get("blockTransactions")
    if rows:
        feed.projected_rows[idx] = {r[0]: r for r in rows if r}
        # Die Vollform setzt das Aenderungsbuch zurueck: alles davor ist
        # wertlos, wer einen aelteren Stand hat, bekommt wieder die Vollform.
        feed.projected_seq[idx] = feed.projected_seq.get(idx, 0) + 1
        feed.projected_log[idx] = []
        feed.projected_at[idx] = time.time()
        return True

    d = p.get("delta")
    if not d:
        return False
    cur = feed.projected_rows.get(idx)
    if cur is None:
        # Ohne Vollform ist eine Aenderung nichts wert
        return False
    zugang, abgang = [], []
    for txid in (d.get("removed") or []):
        t = txid if isinstance(txid, str) else (txid[0] if txid else None)
        if t is not None and cur.pop(t, None) is not None:
            abgang.append(t)
    for r in (d.get("added") or []):
        if r:
            cur[r[0]] = r
            zugang.append(r)
    for r in (d.get("changed") or []):
        # Bekannte Form: [txid, rate, ...] -- die Rate wird nachgezogen. Fuer
        # die Oberflaeche ist das ein Zugang: die Kachel bleibt liegen, nur
        # ihre Gebuehrenfarbe aendert sich.
        if not r:
            continue
        old = cur.get(r[0])
        if old and len(r) > 1:
            new = list(old)
            new[4] = r[1]
            cur[r[0]] = new
            zugang.append(new)

    feed.projected_seq[idx] = feed.projected_seq.get(idx, 0) + 1
    log = feed.projected_log.setdefault(idx, [])
    log.append((feed.projected_seq[idx], zugang, abgang))
    if len(log) > PROJECTED_LOG_KEEP:
        del log[:-PROJECTED_LOG_KEEP]
    feed.projected_at[idx] = time.time()
    return True


def run_ws(feed, still_max=None):
    ws = WebSocket(WS_URL, origin=f"{SCHEME}://{HOST}")
    WS_AKTUELL[0] = ws
    feed.source = "ws"
    feed.error = ""

    # **Die Wache gegen den stummen Draht.** `recv()` kehrt nur bei einem
    # Textrahmen zurueck; Pings beantwortet es selbst und wartet weiter. Ein
    # Knoten, der nur noch pingt, haelt den Faden damit beliebig lange fest.
    # Diese Wache laeuft daneben, schaut auf die Uhr des letzten Textrahmens
    # und raeumt den Sockel ab -- `recv()` faellt dann mit einer Ausnahme
    # heraus, und der Aufrufer verbindet neu (und haelt derweil per REST nach).
    grenze = WS_STILL_MAX if still_max is None else still_max
    letzte = [time.time()]
    halt = threading.Event()

    def wache():
        while not halt.wait(min(5.0, grenze / 4.0)):
            still = time.time() - letzte[0]
            if still > grenze:
                sys.stderr.write(
                    "WebSocket schweigt seit %.0f s -- Verbindung wird abgeraeumt\n" % still)
                try:
                    ws.sock.shutdown(socket.SHUT_RDWR)
                except Exception:
                    pass
                return

    threading.Thread(target=wache, daemon=True).start()
    try:
        ws.send(json.dumps({"action": "init"}))
        ws.send(json.dumps({"action": "want",
                            "data": ["blocks", "stats", "mempool-blocks"]}))
        last_write = 0.0
        while True:
            raw = ws.recv()
            letzte[0] = time.time()
            if raw is None:
                continue
            try:
                msg = json.loads(raw)
            except ValueError:
                continue
            p = msg.get("projected-block-transactions")
            if p is not None:
                handle_projected(feed, p)
            else:
                handle(feed, msg)

            # Niemand sieht mehr hin -> abbestellen. Sonst laeuft der Strom
            # dauerhaft mit, und das sind rund 8 kB/s.
            if feed.want_track is not None and time.time() > feed.track_until:
                feed.want_track = None

            # Ab- und Anmelden geschieht hier, im selben Faden wie das Senden
            if feed.want_track != feed.tracked:
                try:
                    ws.send(json.dumps({"track-mempool-block":
                                        feed.want_track if feed.want_track is not None else -1}))
                    feed.tracked = feed.want_track
                except Exception:
                    pass

            now = time.time()
            if feed.dirty and now - last_write >= WRITE_INTERVAL:
                feed.write()
                last_write = now
    finally:
        halt.set()
        ws.close()


