# --------------------------------------------------------------------------
# Adressen aus einem xpub -- **nur oeffentliche Rechnung**
# --------------------------------------------------------------------------
# Verbindlicher Grundsatz des Projekts (ZIELBILD.md, 01.09.2026): die Anwendung
# ist ein Betrachter. Hier steht deshalb ausschliesslich Punktarithmetik auf
# secp256k1 -- es gibt in diesem Programm keinen privaten Schluessel, keine
# Signatur und nichts, was eine erzeugen koennte. Gehaertete Ableitung ist
# bewusst nicht moeglich; sie braeuchte den privaten Schluessel.
#
# Der xpub verlaesst das Geraet nie: die Adressen werden hier abgeleitet und
# einzeln abgefragt. Wer den xpub an einen Dienst gibt, zeigt ihm die ganze
# Wallet -- jede vergangene und jede kuenftige Adresse.
#
# Gegengeprueft am 02.09.2026: die Testvektoren aus SLIP-0132 (xpub/ypub/zpub,
# je erste Adresse) und BIP-0084 (zwei Empfangs-, eine Wechseladresse und der
# oeffentliche Schluessel) stimmen alle; dazu 101 echte Ausgaenge aus der Kette
# in fuenf Skriptformen gegen `scriptpubkey_address` von mempool.space, ohne
# eine einzige Abweichung.

# --------------------------------------------------------------------------
# secp256k1 -- nur so viel, wie die oeffentliche Ableitung braucht
# --------------------------------------------------------------------------
_P = 2 ** 256 - 2 ** 32 - 977
_N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141
_G = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798,
      0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)


def _add(p, q):
    """Punktaddition auf y^2 = x^3 + 7. None ist der unendlich ferne Punkt."""
    if p is None:
        return q
    if q is None:
        return p
    if p[0] == q[0]:
        if (p[1] + q[1]) % _P == 0:
            return None
        m = (3 * p[0] * p[0]) * pow(2 * p[1], _P - 2, _P) % _P
    else:
        m = (q[1] - p[1]) * pow(q[0] - p[0], _P - 2, _P) % _P
    x = (m * m - p[0] - q[0]) % _P
    return (x, (m * (p[0] - x) - p[1]) % _P)


def _mul(k, p):
    """Verdoppeln und Addieren."""
    r = None
    while k:
        if k & 1:
            r = _add(r, p)
        p = _add(p, p)
        k >>= 1
    return r


def _decompress(sec):
    """33 Byte Kurzform -> Punkt. y aus x^3 + 7, Vorzeichen aus dem ersten Byte."""
    if len(sec) != 33 or sec[0] not in (2, 3):
        raise ValueError("kein gueltiger Punkt")
    x = int.from_bytes(sec[1:], "big")
    y = pow((x * x * x + 7) % _P, (_P + 1) // 4, _P)
    if y % 2 != sec[0] % 2:
        y = _P - y
    if (y * y - (x * x * x + 7)) % _P != 0:
        raise ValueError("Punkt liegt nicht auf der Kurve")
    return (x, y)


def _compress(pt):
    return bytes([2 + (pt[1] & 1)]) + pt[0].to_bytes(32, "big")


# --------------------------------------------------------------------------
# Base58Check und Bech32
# --------------------------------------------------------------------------
_B58 = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"


def b58_encode(raw):
    n = int.from_bytes(raw, "big")
    out = ""
    while n:
        n, r = divmod(n, 58)
        out = _B58[r] + out
    return "1" * (len(raw) - len(raw.lstrip(b"\x00"))) + out


def b58_decode(s):
    n = 0
    for c in s:
        i = _B58.find(c)
        if i < 0:
            raise ValueError("kein Base58")
        n = n * 58 + i
    raw = n.to_bytes((n.bit_length() + 7) // 8, "big")
    return b"\x00" * (len(s) - len(s.lstrip("1"))) + raw


def b58check_encode(payload):
    chk = hashlib.sha256(hashlib.sha256(payload).digest()).digest()[:4]
    return b58_encode(payload + chk)


def b58check_decode(s):
    raw = b58_decode(s)
    if len(raw) < 5:
        raise ValueError("zu kurz")
    body, chk = raw[:-4], raw[-4:]
    if hashlib.sha256(hashlib.sha256(body).digest()).digest()[:4] != chk:
        raise ValueError("Pruefsumme stimmt nicht")
    return body


_BECH32 = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"


def _polymod(values):
    gen = [0x3B6A57B2, 0x26508E6D, 0x1EA119FA, 0x3D4233DD, 0x2A1462B3]
    chk = 1
    for v in values:
        b = chk >> 25
        chk = (chk & 0x1FFFFFF) << 5 ^ v
        for i in range(5):
            chk ^= gen[i] if (b >> i) & 1 else 0
    return chk


def _hrp_expand(hrp):
    return [ord(c) >> 5 for c in hrp] + [0] + [ord(c) & 31 for c in hrp]


def _convertbits(data, frm, to, pad=True):
    acc, bits, out = 0, 0, []
    maxv = (1 << to) - 1
    for b in data:
        acc = (acc << frm) | b
        bits += frm
        while bits >= to:
            bits -= to
            out.append((acc >> bits) & maxv)
    if pad and bits:
        out.append((acc << (to - bits)) & maxv)
    return out


def bech32_address(hrp, witver, program):
    """BIP173 fuer Zeugnisfassung 0, BIP350 (bech32m) ab Fassung 1."""
    data = [witver] + _convertbits(program, 8, 5)
    const = 1 if witver == 0 else 0x2BC830A3
    values = _hrp_expand(hrp) + data
    poly = _polymod(values + [0, 0, 0, 0, 0, 0]) ^ const
    chk = [(poly >> 5 * (5 - i)) & 31 for i in range(6)]
    return hrp + "1" + "".join(_BECH32[d] for d in data + chk)


def hash160(b):
    return hashlib.new("ripemd160", hashlib.sha256(b).digest()).digest()


