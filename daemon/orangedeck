class Feed:
    def __init__(self):
        self.seq = 0
        self.recent = []          # juengste TX, aelteste zuerst
        self.mempool = {"count": 0, "vsize": 0, "totalFee": 0}
        self.fees = {}
        self.vbps = 0
        self.next_block = {}
        self.tip = {}
        self.price = {}
        self.block_event = 0      # Zeitstempel des zuletzt gesehenen Blocks
        self.source = "start"
        self.error = ""
        self.dirty = True
        self.summary_for = None
        # Langsame Kennzahlen fuer die Uhr, und der eigene Miner
        self.difficulty = {}
        self.hashrate = {}
        self.miners = []          # je Geraet ein normalisierter Satz Felder
        self.miner_total = {}     # Summe ueber alle erreichbaren Geraete
        self.slow_at = 0.0
        self.miner_at = 0.0
        # Geplante Bloecke: was gerade verfolgt wird und was dabei herauskam
        self.want_track = None      # gewuenschter Rang, oder None
        self.tracked = None         # was tatsaechlich abonniert ist
        self.track_until = 0.0      # bis wann jemand hinsieht
        # Die geplanten Bloecke in Kurzform, so wie sie ueber den WebSocket
        # hereinkommen -- damit die Startseite sie ohne eigene Abfrage
        # lebendig zeigen kann.
        self.projected = []
        self.projected_rows = {}    # Rang -> {txid: Zeile}, laufend gepflegt
        self.projected_at = {}      # Rang -> wann zuletzt geaendert
        self.projected_tiles = {}   # Rang -> aufbereitete Kacheldaten
        # Aenderungsbuch je Rang. Ohne es muesste die Oberflaeche bei jeder
        # Abfrage die ganze Liste holen -- gemessen 583 kB alle zwei Sekunden,
        # und das JSON-Zerlegen davon kostete allein 6 % CPU.
        self.projected_seq = {}     # Rang -> laufende Nummer
        self.projected_log = {}     # Rang -> [(Nummer, zugegangen, abgegangen)]
        self.stats_hist = {"t": [], "count": [], "vbps": [], "inflow": []}
        # Hochgezaehlt, sobald sich eines der SLOW_FIELDS aendert. Die
        # Oberflaeche schickt ihren Stand mit und bekommt sie nur dann.
        self.slow_rev = 0
        self.stats_at = 0.0
        self.stats_seq = 0
        self.miner_hist = {}      # Geraete-Kennung -> Verlauf
        self.miner_dom = {}       # Geraete-Kennung -> letzte Domaenenmessungen
        self.scoreboard = {}      # Geraete-Kennung -> Bestenliste
        self.scoreboard_at = 0.0
        # Beobachtete Wallets (watch-only)
        self.wallets = []
        self.watch_txids = set()  # eigene TX -- werden in der Halde markiert
        self.watch_at = 0.0
        self.watch_now = True     # beim Start sofort abtasten
        self.watch_busy = False
        self.watch_stop = False

    # -- Einspeisung ------------------------------------------------------
    def add_txs(self, txs):
        # **Dieselbe Transaktion zweimal.** Am 17.09.2026 am Galaxy gesehen:
        # kurz nach dem Start standen fuenf von zwoelf Zeilen doppelt in
        # "Zuletzt im Mempool gesehen". Hier faellt es noch staerker an --
        # `poll_rest` holt `/mempool/recent` bei **jedem** Durchlauf, und das
        # sind jedes Mal weitgehend dieselben Eintraege. Wer schon in der
        # Liste steht, kommt nicht noch einmal dazu.
        drin = {r["t"] for r in self.recent if r.get("t")}
        for t in txs:
            try:
                # Ohne TxID laesst sich nichts vergleichen, die kommt mit.
                # Geprueft wird **vor** `seq`: die Nummer ist die Marke, an
                # der die Ansicht abschneidet, und darf keine Luecken haben.
                txid = t.get("txid") or ""
                if txid:
                    if txid in drin:
                        continue
                    drin.add(txid)
                rate = t.get("rate")
                vsize = float(t.get("vsize") or 0) or 1.0
                if rate is None:
                    rate = float(t.get("fee") or 0) / vsize
                self.seq += 1
                eintrag = {
                    "n": self.seq,
                    "t": txid,                    # voll, fuer den Tooltip
                    "v": round(vsize, 1),
                    "r": round(float(rate), 3),
                    "a": int(t.get("value") or 0),
                    "f": int(t.get("fee") or 0),
                }
                # Gehoert sie zu einer beobachteten Wallet, wird sie in der
                # Halde hervorgehoben. Ein Feld an der Kachel, keine zweite
                # Grafik.
                if txid and txid in self.watch_txids:
                    eintrag["m"] = 1
                self.recent.append(eintrag)
            except (TypeError, ValueError):
                continue
        if len(self.recent) > RECENT_KEEP:
            self.recent = self.recent[-RECENT_KEEP:]
        self.dirty = True

    def set_mempool(self, info):
        self.mempool = {
            "count": int(info.get("size") or 0),
            "vsize": int(info.get("bytes") or 0),
            "totalFee": round(float(info.get("total_fee") or 0) * 1e8),
        }
        self.dirty = True

    def set_next_block(self, blocks):
        if not blocks:
            return
        b = blocks[0]
        self.next_block = {
            "nTx": int(b.get("nTx") or 0),
            "vsize": round(float(b.get("blockVSize") or 0)),
            "medianFee": round(float(b.get("medianFee") or 0), 2),
            "totalFees": int(b.get("totalFees") or 0),
            "depth": len(blocks),
        }
        # Die ganze Reihe mitfuehren, nicht nur den naechsten Block. Der
        # WebSocket schickt sie ohnehin bei jeder Aenderung mit; sie hier
        # abzulegen erspart der Oberflaeche die REST-Abfrage
        # `/v1/fees/mempool-blocks` und macht die Leiste auf der
        # Explorer-Startseite lebendig. Die Feldnamen sind bewusst dieselben
        # wie in der REST-Antwort -- beide Quellen sind austauschbar.
        self.projected = [{
            "nTx": int(x.get("nTx") or 0),
            "blockSize": int(x.get("blockSize") or 0),
            "blockVSize": round(float(x.get("blockVSize") or 0)),
            "medianFee": round(float(x.get("medianFee") or 0), 2),
            "totalFees": int(x.get("totalFees") or 0),
            "feeRange": [round(float(v), 2) for v in (x.get("feeRange") or [])],
        } for x in blocks[:PROJECTED_KEEP]]
        self.dirty = True

    def watch_refresh(self):
        """Nach einem Blockfund lohnt das Nachsehen -- vorher aendert sich an
        einer bestaetigten Wallet nichts."""
        if self.wallets:
            self.watch_now = True

    def set_tip(self, b, is_new=False):
        if not b:
            return
        height = int(b.get("height") or 0)
        if height and height == self.tip.get("height") and not is_new:
            return
        ex = b.get("extras") or {}
        pool = (ex.get("pool") or {}).get("name") or ""
        self.tip = {
            "height": height,
            "id": b.get("id") or "",
            "time": int(b.get("timestamp") or 0),
            "nTx": int(b.get("tx_count") or 0),
            "size": int(b.get("size") or 0),
            "weight": int(b.get("weight") or 0),
            "medianFee": round(float(ex.get("medianFee") or 0), 2),
            "totalFees": int(ex.get("totalFees") or 0),
            "reward": int(ex.get("reward") or 0),
            "pool": pool,
        }
        if is_new:
            self.block_event = time.time()
            self.watch_refresh()
        self.dirty = True
        self.request_summary()

    def request_summary(self):
        """Kacheldaten des aktuellen Blocks nachladen, ohne den Socket zu blockieren."""
        bid = self.tip.get("id")
        if not bid or bid == self.summary_for:
            return
        self.summary_for = bid
        tip = dict(self.tip)

        def work():
            try:
                write_block_summary(tip)
            except Exception as e:
                sys.stderr.write("Blockzusammenfassung fehlgeschlagen: %s\n" % e)
                if self.summary_for == tip.get("id"):
                    self.summary_for = None

        threading.Thread(target=work, daemon=True).start()

    # -- Ausgabe ----------------------------------------------------------
    def snapshot(self, since=0, slow_rev=-1):
        """Der Zustand, auf Wunsch gekuerzt.

        Gemessen am 02.09.2026: die Vollform ist 32 kB, und die Oberflaeche
        holt sie alle 400 ms -- 80 kB/s JSON, die im Zeichenfaden zerlegt
        werden. Das kostete **20 % CPU** gegenueber 5,8 % im Direktbezug.
        Zwei Drittel davon sind Ballast:

          recent        16 kB, wovon die Ansicht alles bis `seq` wegwirft
          stats +
          minerHistory  14 kB, die sich hoechstens im Minutentakt aendern

        Mit `?since=<seq>` kommen nur noch die neuen Transaktionen, mit
        `?slow=<rev>` bleiben die langsamen Felder weg, solange sie sich nicht
        geaendert haben. Was fehlt, behaelt die Oberflaeche vom vorigen Stand.
        Ohne Parameter bleibt alles wie vorher -- aeltere Fassungen und
        `curl` merken nichts davon."""
        d = {
            "ts": round(time.time(), 2),
            "source": self.source,
            "instance": "%s://%s" % (SCHEME, HOST),
            "error": self.error,
            "mempool": self.mempool,
            "fees": self.fees,
            "vbps": self.vbps,
            "nextBlock": self.next_block,
            "projected": self.projected,
            "tip": self.tip,
            "price": self.price,
            "blockEvent": round(self.block_event, 2),
            "seq": self.seq,
            "slowRev": self.slow_rev,
            "recent": ([r for r in self.recent if r["n"] > since] if since
                       else self.recent[-RECENT_KEEP:]),
            "difficulty": self.difficulty,
            "stats": self.stats_hist,
            "hashrate": self.hashrate,
            "miners": self.miners,
            "minerHistory": self.miner_hist,
            "minerTotal": self.miner_total,
            # Nur die Kurzfassung -- die vollen Angaben stehen unter /wallets
            "wallets": [{
                "name": w.get("name", ""),
                "kind": w.get("kind", ""),
                "balance": w.get("balance", 0),
                "pending": w.get("pending", 0),
                "used": w.get("used", 0),
                "txCount": w.get("txCount", 0),
                "error": w.get("error", ""),
            } for w in self.wallets],
            "walletBusy": self.watch_busy,
        }
        if slow_rev == self.slow_rev:
            for k in SLOW_FIELDS:
                d.pop(k, None)
        return d

    def write(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(self.snapshot(), f, separators=(",", ":"))
        os.replace(tmp, STATE_FILE)
        self.dirty = False


# --------------------------------------------------------------------------
# Explorer: Abfragen weiterreichen
# --------------------------------------------------------------------------
# Die Oberflaeche fragt **nicht** selbst bei mempool.space an, sondern hier.
# Drei Gruende: nur eine Stelle weiss, wo die Daten herkommen (und laesst sich
# damit auf einen eigenen Node umstellen); das Tablet spricht ohnehin nur mit
# dem Daemon; und ein Zwischenspeicher verhindert, dass jede Mausbewegung eine
# Anfrage nach draussen ausloest.
LOOKUP_TTL = 45          # Sekunden -- Blocktakt ist zehn Minuten
LOOKUP_TTL_MEMPOOL = 8   # fuer noch unbestaetigte Sachen kuerzer
LOOKUP_MAX = 400
# Wie lange nach der letzten Abfrage weiter mitgehoert wird. Fragt die
# Oberflaeche im Sekundentakt, bleibt der Strom an; sieht niemand mehr hin,
# endet er von selbst.
PROJECTED_LINGER = 20

_lookup_cache = {}
_lookup_lock = threading.Lock()
# Der Feed wird beim Start hier eingehaengt -- die Abfrage fuer geplante
# Bloecke braucht ihn, weil die Daten ueber den WebSocket kommen.
_feed_ref = [None]

# Nur diese Formen werden weitergereicht. Kein freier Durchgriff nach aussen.
LOOKUP_ROUTES = (
    ("tx", re.compile(r"^[0-9a-f]{64}$"), "/tx/%s"),
    ("txstatus", re.compile(r"^[0-9a-f]{64}$"), "/tx/%s/status"),
    ("outspends", re.compile(r"^[0-9a-f]{64}$"), "/tx/%s/outspends"),
    ("block", re.compile(r"^[0-9a-f]{64}$"), "/block/%s"),
    ("blocktxids", re.compile(r"^[0-9a-f]{64}$"), "/block/%s/txids"),
    ("blockheight", re.compile(r"^[0-9]{1,9}$"), "/block-height/%s"),
    ("address", re.compile(r"^[a-zA-Z0-9]{20,100}$"), "/address/%s"),
    ("addresstxs", re.compile(r"^[a-zA-Z0-9]{20,100}$"), "/address/%s/txs"),
    # Die letzten Bloecke fuer die Kettenansicht. "recent" ist ein fester
    # Platzhalter -- der Pfad nimmt keinen Wert entgegen.
    ("blocks", re.compile(r"^(recent|[0-9]{1,9})$"), "/v1/blocks"),
    # Der Block mit allem Drum und Dran: Pool, Belohnung, Gebuehrenspanne,
    # UTXO-Aenderung, SegWit-Anteil, Coinbase.
    ("blockinfo", re.compile(r"^[0-9a-f]{64}$"), "/v1/block/%s"),
    # Kacheldaten -- **nicht** weitergereicht, sondern hier aufbereitet
    ("blocktiles", re.compile(r"^[0-9a-f]{64}$"), None),
    # Die geplanten Bloecke: was aus dem Mempool als naechstes in Bloecke
    # passen wuerde. "now" ist ein fester Platzhalter.
    ("mempoolblocks", re.compile(r"^now$"), "/v1/fees/mempool-blocks"),
    # Ersetzte Transaktionen (RBF)
    ("replacements", re.compile(r"^now$"), "/v1/replacements"),
    # Kacheldaten eines **geplanten** Blocks. Kommen nicht ueber REST, sondern
    # ueber den WebSocket -- siehe lookup().
    # "0" liefert die Vollform, "0-1234" nur, was sich seit Nummer 1234
    # geaendert hat.
    ("projectedtiles", re.compile(r"^[0-7](-[0-9]{1,9})?$"), None),
)


def fehlergrund(e):
    """Aus einer Ausnahme einen kurzen Grund machen, den die Oberflaeche kennt.

    **Warum ueberhaupt.** Bis zum 18.09.2026 ging `str(e)` unveraendert an die
    Anwendung und stand dort auf dem Bildschirm: "HTTP Error 429: Too Many
    Requests", "<urlopen error [Errno -3] Temporary failure in name
    resolution>". Das ist Python-Deutsch, in keiner Sprache uebersetzt und
    fuer den Ablesenden ohne Wert. Die Oberflaeche uebersetzt, was sie kennt
    (`GRUENDE` in `strings.js`), und kennt nur kurze Gruende.

    Die technische Fassung geht nicht verloren, sie geht ins Protokoll -- dort
    gehoert sie hin, und dort steht sie mit Zeitstempel."""
    sys.stderr.write("Abfrage gescheitert: %r\n" % (e,))
    if isinstance(e, urllib.error.HTTPError):
        if e.code == 404:
            return "nicht gefunden"
        if e.code == 429:
            return "zu viele Abfragen"
        return "nicht erreichbar"
    # `socket.timeout` ist seit 3.10 `TimeoutError`; beides kommt vor, je
    # nachdem, wer wirft.
    if isinstance(e, (TimeoutError, socket.timeout)):
        return "keine Antwort"
    if "timed out" in str(e):
        return "keine Antwort"
    return "nicht erreichbar"


def lookup(kind, arg):
    """Eine Abfrage nach draussen, gepuffert. Gibt (Text, Fehler) zurueck."""
    for name, pattern, path in LOOKUP_ROUTES:
        if name != kind:
            continue
        if not pattern.match(arg or ""):
            return None, ("unzulaessige Eingabe", 400)
        key = (kind, arg)
        now = time.time()
        with _lookup_lock:
            hit = _lookup_cache.get(key)
            if hit and now < hit[0]:
                return hit[1], None

        # Kacheldaten werden aufbereitet, nicht durchgereicht: 700 kB
        # Transaktionsliste werden zu rund 8 kB.
        if kind == "projectedtiles":
            # Der WebSocket-Faden abonniert und legt das Ergebnis ab. Hier nur
            # anfordern und warten -- die Vollform kommt binnen weniger
            # Sekunden.
            rank, _, since = arg.partition("-")
            idx = int(rank)
            feed = _feed_ref[0]
            if feed is None:
                return None, ("Feed laeuft nicht", 503)

            # Jede Abfrage verlaengert das Mithoeren. Hoert die Oberflaeche auf
            # zu fragen, meldet sich der Daemon von selbst wieder ab.
            feed.want_track = idx
            feed.track_until = now + PROJECTED_LINGER

            deadline = now + 25
            while True:
                rows = feed.projected_rows.get(idx)
                if rows:
                    break
                if time.time() >= deadline:
                    return None, ("keine Antwort vom Server", 504)
                time.sleep(0.2)

            seq = feed.projected_seq.get(idx, 0)
            # Nur die Aenderungen, wenn der Fragende nah genug dran ist. Sonst
            # die Vollform -- die traegt den Stand mit, an dem er weiterzaehlt.
            if since:
                delta = projected_delta(feed, idx, int(since), len(rows))
                if delta is not None:
                    return json.dumps(delta, separators=(",", ":")), None

            # Aus dem gepflegten Bestand aufbereiten -- nach Rate absteigend,
            # so wie der Server sie auch sortiert schickt.
            data = compress_projected(idx, sorted(rows.values(),
                                                  key=lambda r: -(r[4] or 0)))
            data["full"] = True
            data["seq"] = seq
            data["changedAt"] = round(feed.projected_at.get(idx, 0), 2)
            return json.dumps(data, separators=(",", ":")), None

        if kind == "blocktiles":
            try:
                data = summarize_block(arg)
            except Exception as e:
                return None, (fehlergrund(e), 502)
            if not data:
                return None, ("keine Transaktionsliste", 502)
            body = json.dumps(data, separators=(",", ":"))
            with _lookup_lock:
                if len(_lookup_cache) > LOOKUP_MAX:
                    _lookup_cache.clear()
                # Bestaetigte Bloecke aendern sich nicht mehr
                _lookup_cache[key] = (now + 3600, body)
            return body, None

        try:
            # `blocks` kennt zwei Formen: ohne Wert die neuesten, mit Hoehe
            # die fuenfzehn davor.
            if kind in ("mempoolblocks", "replacements"):
                full = path
            elif kind == "blocks":
                full = path if arg == "recent" else (path + "/" + arg)
            else:
                full = path % arg
            req = urllib.request.Request(API + full, headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=12) as r:
                body = r.read().decode()
        except Exception as e:
            return None, (fehlergrund(e), 502)
        # `/block-height/<n>` antwortet mit dem blanken Hash, nicht mit JSON.
        # Weitergereicht scheiterte die Oberflaeche daran ("Antwort nicht
        # lesbar") -- die Suche nach einer Blockhoehe war damit unbrauchbar.
        # Die Schnittstelle sagt application/json zu, also wird auch JSON
        # geliefert: eine Zeichenkette.
        if kind == "blockheight":
            body = json.dumps(body.strip())
        # Unbestaetigtes aendert sich schnell, Bestaetigtes so gut wie nie
        ttl = LOOKUP_TTL_MEMPOOL if '"confirmed":false' in body else LOOKUP_TTL
        with _lookup_lock:
            if len(_lookup_cache) > LOOKUP_MAX:
                _lookup_cache.clear()
            _lookup_cache[key] = (now + ttl, body)
        return body, None
    return None, ("unbekannte Abfrage", 400)


# --------------------------------------------------------------------------
# Loopback-Schnittstelle
# --------------------------------------------------------------------------
# Zaehlt die Abfragen je Pfad. Damit laesst sich nachpruefen, ob eine
# Oberflaeche wirklich aufhoert zu fragen, wenn niemand hinsieht -- offene
# Verbindungen taugen dafuer nicht, die bleiben durch Keep-Alive bestehen.
_hits = {}
_hits_lock = threading.Lock()


class _Handler(BaseHTTPRequestHandler):
    """Nur lesend, nur GET, nur die drei Pfade. Kein Zustand wird entgegen-
    genommen -- der Dienst nimmt grundsaetzlich nichts an."""

    protocol_version = "HTTP/1.1"
    feed = None

    def _send(self, body, status=200, ctype="application/json"):
        raw = body if isinstance(body, bytes) else body.encode()
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(raw)

    def do_POST(self):
        """Der einzige schreibende Weg: die Mempool-Instanz umstellen.

        **Nur vom eigenen Rechner.** Lauscht der Dienst im Netz
        (ORANGEDECK_ADDR), darf trotzdem niemand dort die Quelle umbiegen:
        eine fremde Instanz saehe die Abfragen der beobachteten Adressen.
        **Nur JSON und ohne Origin**, damit auch eine Webseite im Browser auf
        diesem Rechner es nicht kann: Browser schicken bei jeder fremden
        POST-Anfrage einen Origin-Kopf mit, und fuer JSON fragen sie vorher
        per OPTIONS, das dieser Dienst nicht beantwortet."""
        if urlparse(self.path).path != "/config":
            self._send(json.dumps({"error": "unbekannt"}), 404)
            return
        adresse = self.client_address[0] if self.client_address else ""
        if adresse not in ("127.0.0.1", "::1", "::ffff:127.0.0.1"):
            self._send(json.dumps({"error": "nur lokal"}), 403)
            return
        if self.headers.get("Origin") or \
                (self.headers.get("Content-Type") or "").split(";")[0].strip() != "application/json":
            self._send(json.dumps({"error": "abgelehnt"}), 403)
            return
        try:
            laenge = int(self.headers.get("Content-Length") or 0)
            if laenge <= 0 or laenge > 4096:
                raise ValueError
            d = json.loads(self.rfile.read(laenge).decode("utf-8"))
            eingabe = str(d.get("mempool", ""))
        except Exception:
            self._send(json.dumps({"error": "Anfrage nicht lesbar"}), 400)
            return
        if not mempool_umstellen(self.feed, eingabe):
            self._send(json.dumps({"error": "Adresse nicht gueltig"}), 400)
            return
        self._send(json.dumps({"ok": True, "instance": "%s://%s" % (SCHEME, HOST)}))

    def do_GET(self):
        zerlegt = urlparse(self.path)
        path = zerlegt.path
        with _hits_lock:
            key = path.split("/")[1] if "/" in path[1:] else path.lstrip("/")
            _hits[key] = _hits.get(key, 0) + 1
        try:
            if path == "/state":
                # `?since=<seq>&slow=<rev>` -- beides freiwillig. Ohne die
                # Parameter kommt die Vollform wie eh und je.
                seit, langsam = 0, -1
                for teil in (zerlegt.query or "").split("&"):
                    name, _, wert = teil.partition("=")
                    try:
                        if name == "since":
                            seit = max(0, int(wert))
                        elif name == "slow":
                            langsam = int(wert)
                    except ValueError:
                        pass
                self._send(json.dumps(self.feed.snapshot(seit, langsam),
                                      separators=(",", ":")))
            elif path == "/block":
                try:
                    with open(BLOCK_FILE, "rb") as f:
                        self._send(f.read())
                except FileNotFoundError:
                    self._send("{}")
            elif path.startswith("/lookup/"):
                parts = path.split("/", 3)
                if len(parts) < 4:
                    self._send('{"error":"Abfrage unvollstaendig"}', 400)
                else:
                    body, err = lookup(parts[2], parts[3])
                    if err:
                        self._send(json.dumps({"error": err[0]}), err[1])
                    else:
                        self._send(body)
            elif path == "/market/heatmap":
                # `?range=...&secs=...&cur=...` -- dieselben Fenster wie
                # `/market`. **Ein eigener Weg**, weil das Modell nur im
                # Heatmap-Reiter gebraucht wird und `/market` jede Sekunde
                # geholt wird.
                spanne, eigen, waehrung = "24h", 0, "usd"
                for teil in (zerlegt.query or "").split("&"):
                    name, _, wert = teil.partition("=")
                    try:
                        if name == "range" and (wert in KLINE_SPANS or wert == "custom"):
                            spanne = wert
                        elif name == "secs":
                            eigen = max(300, min(400000000, int(wert)))
                        elif name == "cur" and wert.isalpha() and len(wert) == 3:
                            waehrung = wert.lower()
                    except ValueError:
                        pass
                # **Dreissig Tage sind die Grenze**, weiter zurueck gibt
                # Binance den Verlauf des offenen Interesses nicht mehr her.
                #
                # Statt abzulehnen wird **zurechtgeschnitten**: wer ein
                # Fenster von fuenf Jahren offen hat, will nicht eine
                # Begruendung sehen, sondern das, was geht. Die Antwort sagt
                # mit `clamped`, dass sie einen anderen Zeitraum zeigt als
                # den gewaehlten -- verschwiegen waere das eine Luege.
                gewuenscht = (eigen if (spanne == "custom" and eigen)
                              else KLINE_SPANS.get(spanne, ("", 0))[1]
                              * {"1m": 60, "3m": 180, "5m": 300, "15m": 900,
                                 "30m": 1800, "1h": 3600, "2h": 7200,
                                 "4h": 14400, "6h": 21600, "12h": 43200,
                                 "1d": 86400, "3d": 259200,
                                 "1w": 604800}.get(
                                     KLINE_SPANS.get(spanne, ("1h", 0))[0], 3600))
                grenze = OI_MAX_TAGE * 86400
                zu_lang = gewuenscht > grenze
                # **Weniger Spalten als beim Kurs.** `raster_fuer` zielt auf
                # bis zu 400 Kerzen; hier ist jede Spalte 64 Zellen breit,
                # und 360 Spalten waren 249 kB fuer ein Bild, das in kein
                # Popout so fein hineinpasst. Rund 180 genuegen.
                def raster_heat(sekunden):
                    for name, laenge in KLINE_LADDER:
                        if sekunden / laenge <= 200:
                            return name, max(20, min(1000,
                                                     int(round(sekunden / laenge))))
                    return "1w", 1000
                if zu_lang:
                    kerzen = klines(raster_heat(grenze))
                elif spanne == "custom" and eigen:
                    kerzen = klines(raster_heat(eigen))
                else:
                    kerzen = klines(raster_heat(
                        gewuenscht if gewuenscht > 0 else 86400))
                d = heatmap(kerzen)
                kurs, umgerechnet = markt_kurs(self.feed, waehrung)
                if kurs != 1.0:
                    d["yAxis"] = [round(y * kurs, 2) for y in d["yAxis"]]
                    d["cells"] = [[c[0], c[1], round(c[2] * kurs)] for c in d["cells"]]
                    d["max"] = round(d["max"] * kurs)
                d["converted"] = umgerechnet
                d["clamped"] = zu_lang
                d["maxDays"] = OI_MAX_TAGE
                d["times"] = [k[0] for k in kerzen]
                d["closes"] = [k[4] * kurs for k in kerzen] if kurs != 1.0 \
                    else [k[4] for k in kerzen]
                # Die Annahmen mitschicken -- die Oberflaeche soll sie nennen
                # koennen, ohne sie ein zweites Mal zu kennen.
                d["model"] = {"leverage": [list(x) for x in HEBEL_STUFEN],
                              "longShare": LONG_ANTEIL}
                self._send(json.dumps(d, separators=(",", ":")))
            elif path == "/market/overview":
                # Die ganze Geschichte als Tageskerzen, einmal am Stueck.
                # **Bewusst ein eigener Weg**: sie sind rund 270 kB und
                # aendern sich einmal am Tag, `/market` wird jede Sekunde
                # geholt. Die Oberflaeche laedt sie einmal und zeichnet
                # daraus, solange am Schieber gezogen wird.
                waehrung = "usd"
                for teil in (zerlegt.query or "").split("&"):
                    name, _, wert = teil.partition("=")
                    if name == "cur" and wert.isalpha() and len(wert) == 3:
                        waehrung = wert.lower()
                kerzen = uebersicht()
                kurs, umgerechnet = markt_kurs(self.feed, waehrung)
                if kurs != 1.0:
                    kerzen = [[k[0], round(k[1] * kurs, 2), round(k[2] * kurs, 2),
                               round(k[3] * kurs, 2), round(k[4] * kurs, 2)]
                              + list(k[5:])
                              for k in kerzen]
                self._send(json.dumps({
                    "cur": waehrung,
                    "converted": umgerechnet,
                    "candles": kerzen,
                }, separators=(",", ":")))
            elif path == "/market":
                # `?tf=<sekunden>&n=<anzahl>` -- jede Abfrage haelt die
                # Boersenstroeme am Leben; bleibt sie zwei Minuten aus, gehen
                # sie von selbst wieder zu.
                MARKT.gefragt()
                spanne, eigen, band_seit, waehrung = "24h", 0, 0, "usd"
                von = bis = 0
                for teil in (zerlegt.query or "").split("&"):
                    name, _, wert = teil.partition("=")
                    try:
                        if name == "range" and (wert in KLINE_SPANS or wert == "custom"):
                            spanne = wert
                        elif name == "secs":
                            eigen = max(300, min(400000000, int(wert)))
                        elif name == "tape":
                            band_seit = max(0, int(wert))
                        elif name == "cur" and wert.isalpha() and len(wert) == 3:
                            waehrung = wert.lower()
                        elif name == "from":
                            von = max(0, int(wert))
                        elif name == "to":
                            bis = max(0, int(wert))
                    except ValueError:
                        pass
                if von and bis and bis > von:
                    # Ausdruecklich von ... bis -- der Zeitraum ergibt sich
                    # daraus, der Name spielt dann keine Rolle mehr.
                    kerzen = klines(None, von=von, bis=bis)
                elif bis:
                    # Dieselbe Fensterlaenge, aber frueher zu Ende: das ist
                    # das Verschieben auf der Zeitachse.
                    laenge = eigen if (spanne == "custom" and eigen) else 0
                    if laenge:
                        kerzen = klines(None, von=bis - laenge, bis=bis)
                    else:
                        kerzen = klines(spanne, bis=bis)
                elif spanne == "custom" and eigen:
                    kerzen = klines(raster_fuer(eigen))
                else:
                    kerzen = klines(spanne)
                band, band_letzte = MARKT.band_seit(band_seit)
                # Die Marken gehoeren in dasselbe Fenster wie die Kerzen --
                # abgeleitet aus dem, was zurueckkommt, nicht aus dem, was
                # gefragt wurde: bei "all" weiss nur die Antwort, wo sie
                # anfaengt.
                # **Bis ans Ende der letzten Kerze, mindestens einen Tag.**
                # Bis zum 16.09.2026 stand hier pauschal ein Tag: bei "all"
                # mit Wochenkerzen fiel damit alles nach dem ersten Tag der
                # laufenden Woche heraus, die Ansicht blieb leer.
                if kerzen:
                    schritt = kerzen[-1][0] - kerzen[-2][0] if len(kerzen) > 1 else 0
                    liq_von, liq_bis = kerzen[0][0], kerzen[-1][0] + max(86400, schritt)
                else:
                    liq_von, liq_bis = 0, 0
                liq = LIQ.fenster(liq_von, liq_bis) if liq_von else []
                # Das Histogramm ueber **dieselbe** Preisspanne wie das Bild.
                # Aus den geholten Kerzen abgeleitet, nicht aus den Marken:
                # sonst haette es eine eigene Skala.
                if kerzen:
                    liq_tief = min(k[3] for k in kerzen)
                    liq_hoch = max(k[2] for k in kerzen)
                    liq_hist = LIQ.histogramm(liq_von, liq_bis, liq_tief, liq_hoch)
                else:
                    liq_hist = []
                kurs, umgerechnet = markt_kurs(self.feed, waehrung)
                if kurs != 1.0:
                    # Preise umrechnen, Mengen nicht -- die sind in Bitcoin.
                    # **Die Mengen muessen mit**: Kauf und Verkauf stehen
                    # dahinter, und ohne sie faellt der CVD aus, sobald jemand
                    # in Euro rechnet.
                    kerzen = [[k[0], round(k[1] * kurs, 2), round(k[2] * kurs, 2),
                               round(k[3] * kurs, 2), round(k[4] * kurs, 2)]
                              + list(k[5:])
                              for k in kerzen]
                    band = [[t[0], t[1], round(t[2] * kurs, 2),
                             round(t[3] * kurs), t[4], t[5]] for t in band]
                    # Preise umrechnen, Mengen nicht -- die sind in Bitcoin.
                    liq = [[x[0], round(x[1] * kurs, 2), x[2], x[3], x[4]]
                           for x in liq]
                    # Im Histogramm ist die Preisstufe umzurechnen, die
                    # Dollarbetraege ebenso -- anders als bei den Mengen, die
                    # in Bitcoin stehen.
                    liq_hist = [[round(x[0] * kurs, 2), round(x[1] * kurs),
                                 round(x[2] * kurs)] for x in liq_hist]
                self._send(json.dumps({
                    "range": spanne,
                    "cur": waehrung,
                    "converted": umgerechnet,
                    "candles": kerzen,
                    "tape": band,
                    "tapeLast": band_letzte,
                    "liq": liq,
                    "liqHist": liq_hist,
                    "ratio": verhaeltnis(),
                    # **Liquidationen gibt es fast nur live** (OKX liefert
                    # rund einen Tag nach, `liq_nachholen`). Damit die
                    # Oberflaeche eine leere Spur von einer stummen Verbindung
                    # unterscheiden kann, steht hier, seit wann zugehoert wird.
                    "liqSince": round(LIQ.seit),
                    "liqSources": [{"id": q["id"], "name": q["name"],
                                    "online": bool(LIQ.online.get(q["id"]))}
                                   for q in LIQUIDATIONEN],
                    "sources": [{"id": q["id"], "name": q["name"],
                                 "online": bool(MARKT.online.get(q["id"]))}
                                for q in MARKETS],
                    "trades": MARKT.trades,
                }, separators=(",", ":")))
            elif path == "/prices":
                # `?span=24h|7d|30d|90d|1y|max&cur=eur` -- beides freiwillig.
                # Bewusst **nicht** im Zustand: der wird 2,5-mal je Sekunde
                # geschrieben, der Verlauf aendert sich stuendlich einmal.
                span, cur = "30d", "eur"
                for teil in (zerlegt.query or "").split("&"):
                    name, _, wert = teil.partition("=")
                    if name == "span" and wert in SPANS:
                        span = wert
                    elif name == "cur" and wert.isalpha() and len(wert) == 3:
                        cur = wert.lower()
                self._send(json.dumps(price_series(span, cur),
                                      separators=(",", ":")))
            elif path == "/network":
                # `?span=30d|90d|1y|3y|max` -- Hashrate, Schwierigkeit und
                # Pools fuer den Reiter "Netz". Nicht im Zustand, siehe
                # network_series().
                span = "1y"
                for teil in (zerlegt.query or "").split("&"):
                    name, _, wert = teil.partition("=")
                    if name == "span" and wert in NET_SPANS:
                        span = wert
                self._send(json.dumps(network_series(span),
                                      separators=(",", ":")))
            elif path == "/wallets":
                # Absichtlich nicht im Zustand: die Wallet-Angaben sind rund
                # 8 kB und aendern sich alle fuenf Minuten, der Zustand wird
                # 2,5-mal je Sekunde geschrieben und ebenso oft geholt. Im
                # Zustand steht nur die Kurzfassung.
                self._send(json.dumps({"wallets": self.feed.wallets,
                                       "busy": self.feed.watch_busy,
                                       "ts": round(time.time(), 2)},
                                      separators=(",", ":")))
            elif path == "/health":
                self._send(json.dumps({
                    "ok": True,
                    "source": self.feed.source,
                    # Nachvollziehbar machen, ob gerade mitgehoert wird
                    "tracking": self.feed.tracked,
                    "trackFor": max(0, round(self.feed.track_until - time.time(), 1)),
                    "hits": dict(_hits),
                }))
            else:
                self._send('{"error":"unbekannter Pfad"}', 404)
        except BrokenPipeError:
            pass
        except Exception as e:
            try:
                self._send(json.dumps({"error": fehlergrund(e)}), 500)
            except Exception:
                pass

    def log_message(self, *a):
        pass   # sonst eine Zeile je Abfrage, mehrmals pro Sekunde


def serve_local(feed):
    """Startet die Loopback-Schnittstelle. Scheitert sie, laeuft der Feed
    trotzdem weiter -- die Dateien werden ja nach wie vor geschrieben."""
    handler = type("Handler", (_Handler,), {"feed": feed})
    try:
        srv = ThreadingHTTPServer((SERVE_ADDR, SERVE_PORT), handler)
    except OSError as e:
        sys.stderr.write("Loopback-Schnittstelle nicht gestartet (%s:%s): %s\n"
                         % (SERVE_ADDR, SERVE_PORT, e))
        return None
    srv.daemon_threads = True
    if SERVE_ADDR not in ("127.0.0.1", "::1", "localhost"):
        sys.stderr.write("WARNUNG: orangedeck ist auf %s erreichbar, nicht nur lokal.\n"
                         % SERVE_ADDR)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv


def sample_stats(feed):
    """Fuellstand und Zulauf des Mempools mitschreiben.

    Der Zulauf ergibt sich aus dem Fortschritt der laufenden Nummer: `seq`
    zaehlt jede gesehene Transaktion, die Differenz zwischen zwei Messungen
    geteilt durch die Zeit ist der Zulauf je Sekunde."""
    now = time.time()
    if now - feed.stats_at < STATS_INTERVAL:
        return
    dt = now - feed.stats_at if feed.stats_at else STATS_INTERVAL
    inflow = (feed.seq - feed.stats_seq) / dt if feed.stats_at else 0
    feed.stats_at = now
    feed.stats_seq = feed.seq

    h = feed.stats_hist
    h["t"].append(round(now))
    h["count"].append(int((feed.mempool or {}).get("count") or 0))
    h["vbps"].append(round(feed.vbps or 0, 1))
    h["inflow"].append(round(max(0.0, inflow), 2))
    for k in ("t", "count", "vbps", "inflow"):
        if len(h[k]) > STATS_HISTORY:
            del h[k][:len(h[k]) - STATS_HISTORY]
    feed.slow_rev += 1
    feed.dirty = True


def poll_slow(feed):
    """Schwierigkeitsanpassung und Hashrate. Beides aendert sich langsam und
    wird deshalb nur alle paar Minuten geholt -- es speist die Uhr und
    den Vergleich mit der Netzschwierigkeit in der Miner-Ansicht."""
    if time.time() - feed.slow_at < SLOW_INTERVAL:
        return
    feed.slow_at = time.time()
    try:
        d = http_json("/v1/difficulty-adjustment")
        feed.slow_rev += 1
        feed.difficulty = {
            "progress": d.get("progressPercent"),
            "change": d.get("difficultyChange"),
            "remainingBlocks": d.get("remainingBlocks"),
            "remainingTime": d.get("remainingTime"),
            "nextHeight": d.get("nextRetargetHeight"),
            "previousChange": d.get("previousRetarget"),
            # Fuer die Tafel auf der Startseite
            "timeAvg": d.get("timeAvg"),
            "retargetDate": d.get("estimatedRetargetDate"),
            "expectedBlocks": d.get("expectedBlocks"),
        }
        feed.dirty = True
    except Exception as e:
        sys.stderr.write("Schwierigkeit: %s\n" % e)
    try:
        # /3d liefert nur drei Messpunkte -- zu wenig fuer eine Kurve.
        # /1m sind 31 Punkte bei 2,2 kB, alle fuenf Minuten geholt.
        h = http_json("/v1/mining/hashrate/1m")
        feed.slow_rev += 1
        feed.hashrate = {
            "current": h.get("currentHashrate"),
            "difficulty": h.get("currentDifficulty"),
            "series": [p.get("avgHashrate") for p in (h.get("hashrates") or [])][-40:],
        }
        feed.dirty = True
    except Exception as e:
        sys.stderr.write("Hashrate: %s\n" % e)


# --------------------------------------------------------------------------
# Miner
# --------------------------------------------------------------------------
# Zwei Protokollfamilien decken praktisch alle ueblichen Geraete ab:
#
#   axeos    HTTP, /api/system/info -- Bitaxe, NerdAxe und die uebrigen
#            ESP-Miner-Abkoemmlinge (AxeOS)
#   cgminer  TCP 4028 mit JSON-Befehlen -- die klassische cgminer-Schnittstelle,
#            die Antminer, Avalon, Whatsminer und viele Nachbauten sprechen
#
# Alle Adapter liefern denselben Satz Felder zurueck, Hashrate immer in H/s.
# Die Ansicht muss dadurch nichts ueber das Geraet wissen.

def parse_diff(v):
    """'1.23M' -> 1230000.0. Die Geraete melden die Bestleistung als Text
    mit Einheit."""
    if isinstance(v, (int, float)):
        return float(v)
    if not v:
        return 0.0
    t = str(v).strip()
    mult = {"k": 1e3, "K": 1e3, "M": 1e6, "G": 1e9, "T": 1e12, "P": 1e15, "E": 1e18}
    f = mult.get(t[-1:], 1.0)
    try:
        return float(t if f == 1.0 else t[:-1]) * f
    except ValueError:
        return 0.0


def probe_axeos(url, timeout=4):
    req = urllib.request.Request(url.rstrip("/") + "/api/system/info",
                                 headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        d = json.loads(r.read().decode())
    def gh(v):
        """AxeOS meldet GH/s -- hier wird ueberall in H/s gerechnet."""
        return float(v) * 1e9 if isinstance(v, (int, float)) else None

    # Die Momentanrate schwankt um rund zehn Prozent (am echten Geraet
    # gemessen: 1103 gegen 1063 GH/s geglaettet). Fuer die Anzeige ist der
    # Zehnminutenwert der ehrlichere -- die Momentanrate bleibt daneben stehen.
    avg = gh(d.get("hashRate_10m")) or gh(d.get("hashRate_1m")) or gh(d.get("hashRate"))

    # Aus der Stratum-Adresse nur den Wirt uebernehmen. Der Benutzername
    # enthaelt bei Solomining die Auszahlungsadresse -- die hat in keinem
    # Zustand, keiner Anzeige und keinem Protokoll etwas verloren.
    pool = (d.get("stratumURL") or "").split("//")[-1].split("/")[0] or None

    return {
        "type": "axeos",
        "id": url,
        "name": d.get("hostname") or d.get("ASICModel") or d.get("boardVersion") or "AxeOS",
        "model": d.get("ASICModel") or d.get("boardVersion") or "",
        "version": d.get("axeOSVersion") or d.get("version") or "",
        "online": True,
        "hashRate": avg or 0.0,                 # geglaettet, das ist der Anzeigewert
        "hashRateNow": gh(d.get("hashRate")),   # Momentanwert
        "expected": gh(d.get("expectedHashrate")),
        "bestDiff": parse_diff(d.get("bestDiff")),
        "bestSessionDiff": parse_diff(d.get("bestSessionDiff")),
        "poolDiff": parse_diff(d.get("poolDifficulty")),
        "netDiffDevice": parse_diff(d.get("networkDifficulty")),
        "blockFound": d.get("blockFound"),
        "errorPct": d.get("errorPercentage"),
        "temp": d.get("temp"),
        "power": d.get("power"),
        "fanRpm": d.get("fanrpm"),
        "shares": d.get("sharesAccepted"),
        "rejected": d.get("sharesRejected"),
        "uptime": d.get("uptimeSeconds"),
        "paused": d.get("miningPaused"),
        "pool": pool,
        # Die einzelnen Rechenwerke -- in der Weboberflaeche "Hashrate Registers"
        "domains": (((d.get("hashrateMonitor") or {}).get("asics") or [{}])[0]
                    .get("domains") or []),
    }


def cgminer_call(host, port, command, timeout=3):
    """Die cgminer-Schnittstelle antwortet mit JSON, haengt aber gern ein
    Nullbyte an und liefert kein Content-Length -- also bis zum Verbindungsende
    lesen und hinten abschneiden."""
    with socket.create_connection((host, int(port)), timeout=timeout) as sk:
        sk.settimeout(timeout)
        sk.sendall(json.dumps({"command": command}).encode())
        buf = b""
        while True:
            try:
                chunk = sk.recv(4096)
            except socket.timeout:
                break
            if not chunk:
                break
            buf += chunk
    return json.loads(buf.rstrip(b"\x00").decode(errors="replace"))


def probe_cgminer(host, port=4028, timeout=3):
    d = cgminer_call(host, port, "summary", timeout)
    row = (d.get("SUMMARY") or [{}])[0]

    def num(*keys):
        for k in keys:
            if row.get(k) is not None:
                try:
                    return float(row[k])
                except (TypeError, ValueError):
                    pass
        return None

    mhs = num("MHS av", "MHS 5s", "MHS 1m") or 0.0
    return {
        "type": "cgminer",
        "id": "%s:%s" % (host, port),
        "name": host,
        "model": (d.get("STATUS") or [{}])[0].get("Description") or "",
        "online": True,
        "hashRate": mhs * 1e6,          # cgminer meldet MH/s
        "bestDiff": parse_diff(row.get("Best Share")),
        "bestSessionDiff": 0.0,
        "temp": num("Temperature"),
        "power": None,
        "shares": int(num("Accepted") or 0),
        "rejected": int(num("Rejected") or 0),
        "uptime": int(num("Elapsed") or 0),
    }


def probe_scoreboard(url, timeout=4):
    """AxeOS fuehrt eine Bestenliste der hoechsten Freigaben. Andere Geraete
    haben nichts Vergleichbares -- dort bleibt sie leer."""
    req = urllib.request.Request(url.rstrip("/") + "/api/system/scoreboard",
                                 headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        rows = json.loads(r.read().decode())
    out = []
    for e in rows[:20]:
        out.append({
            "diff": parse_diff(e.get("difficulty")),
            "time": e.get("ntime"),
            "nonce": e.get("nonce"),
        })
    return out


def probe_miner(spec, timeout=4):
    """Fragt ein einzelnes Geraet ab. Nicht erreichbar ist **kein Fehler**,
    sondern ein Zustand -- die Geraete sind oft schlicht aus."""
    kind = (spec.get("type") or "axeos").lower()
    try:
        if kind == "cgminer":
            return probe_cgminer(spec.get("host"), spec.get("port", 4028), timeout)
        return probe_axeos(spec.get("url") or spec.get("host") or "", timeout)
    except Exception as e:
        return {
            "type": kind,
            "id": spec.get("url") or "%s:%s" % (spec.get("host"), spec.get("port", 4028)),
            "name": spec.get("name") or spec.get("host") or spec.get("url") or "Miner",
            "online": False,
            "error": str(e),
        }


def poll_miners(feed):
    """Alle eingetragenen Geraete. Ohne Eintrag passiert hier gar nichts."""
    specs = SOURCES.get("miners") or []
    if not specs or time.time() - feed.miner_at < MINER_INTERVAL:
        return
    feed.miner_at = time.time()
    found = [probe_miner(sp) for sp in specs]
    live = [m for m in found if m.get("online")]

    # Verlauf fortschreiben. Die Werte werden gerundet abgelegt -- der Zustand
    # wird zweieinhalbmal pro Sekunde geschrieben, da zaehlt jede Stelle.
    now = time.time()
    for m in found:
        h = feed.miner_hist.setdefault(m["id"], {"t": [], "hr": [], "hrNow": [], "temp": [], "err": []})
        h.setdefault("hrNow", [])
        if m.get("online"):
            h["t"].append(round(now))
            h["hr"].append(round((m.get("hashRate") or 0) / 1e9, 1))   # GH/s, geglaettet
            # Der Momentanwert dazu: er schwankt stark und macht damit erst
            # sichtbar, dass die ruhige Linie ein Mittelwert ist.
            h["hrNow"].append(round((m.get("hashRateNow") or 0) / 1e9, 1)
                              if m.get("hashRateNow") else None)
            h["temp"].append(round(m["temp"], 1) if m.get("temp") is not None else None)
            h["err"].append(round(m["errorPct"], 1) if m.get("errorPct") is not None else None)
            for k in ("t", "hr", "hrNow", "temp", "err"):
                if len(h[k]) > MINER_HISTORY:
                    del h[k][:len(h[k]) - MINER_HISTORY]
    # Hash-Domaenen glaetten -- siehe DOMAIN_SMOOTH
    for m in found:
        dom = m.get("domains") or []
        if not (m.get("online") and dom):
            continue
        buf = feed.miner_dom.setdefault(m["id"], [])
        buf.append(dom)
        if len(buf) > DOMAIN_SMOOTH:
            del buf[:len(buf) - DOMAIN_SMOOTH]
        n = min(len(d) for d in buf)
        m["domainsAvg"] = [round(sum(d[i] for d in buf) / len(buf), 1) for i in range(n)]
        m["domainSamples"] = len(buf)

    # Verlaeufe verschwundener Geraete nicht ewig mitschleppen
    known = {m["id"] for m in found}
    for gone in [k for k in feed.miner_hist if k not in known]:
        del feed.miner_hist[gone]
    for gone in [k for k in feed.miner_dom if k not in known]:
        del feed.miner_dom[gone]

    # Bestenliste seltener holen, sie aendert sich kaum
    if now - feed.scoreboard_at >= SCOREBOARD_INTERVAL:
        feed.scoreboard_at = now
        for m in live:
            if m.get("type") != "axeos":
                continue
            try:
                feed.scoreboard[m["id"]] = probe_scoreboard(m["id"])
            except Exception:
                pass
    for m in found:
        sb = feed.scoreboard.get(m["id"])
        if sb:
            m["scoreboard"] = sb
        # Die Rechenwerke einzeln, wie in der Weboberflaeche unter
        # "Hashrate Registers"
        if m.get("domains"):
            pass

    feed.slow_rev += 1
    feed.miners = found
    feed.miner_total = {
        "count": len(found),
        "online": len(live),
        "hashRate": sum(m.get("hashRate") or 0 for m in live),
        "bestDiff": max([m.get("bestDiff") or 0 for m in live] or [0]),
    }
    feed.dirty = True


def local_networks():
    """Die eigenen /24-Netze. Virtuelle Bruecken (libvirt, Docker) bleiben
    draussen -- dort steht kein Miner."""
    out = []
    try:
        res = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"],
                             capture_output=True, text=True, timeout=5)
        for line in res.stdout.splitlines():
            parts = line.split()
            if len(parts) < 4:
                continue
            dev, cidr = parts[1], parts[3]
            if dev.startswith(("virbr", "docker", "br-", "veth", "tun", "tailscale")):
                continue
            addr, _, bits = cidr.partition("/")
            if bits != "24":
                continue
            out.append((dev, addr.rsplit(".", 1)[0]))
    except Exception:
        pass
    return out


def discover_miners(timeout=1.0, workers=64):
    """Sucht im eigenen Netz nach Minern. Bewusst **nur** auf Zuruf: ein
    Suchlauf ueber alle Adressen gehoert nicht in einen Hintergrunddienst.

    Die Geraete haengen ueblicherweise im WLAN und bekommen ihre Adresse per
    DHCP -- eine fest eingetragene Adresse haelt daher selten lange."""
    import queue
    found, q = [], queue.Queue()
    lock = threading.Lock()

    for dev, prefix in local_networks():
        for i in range(1, 255):
            q.put((dev, "%s.%d" % (prefix, i)))

    def worker():
        while True:
            try:
                dev, ip = q.get_nowait()
            except Exception:
                return
            # AxeOS ueber HTTP
            try:
                m = probe_axeos("http://" + ip, timeout=timeout)
                m["via"] = dev
                with lock:
                    found.append(m)
                q.task_done()
                continue
            except Exception:
                pass
            # cgminer ueber TCP 4028
            try:
                m = probe_cgminer(ip, 4028, timeout=timeout)
                m["via"] = dev
                with lock:
                    found.append(m)
            except Exception:
                pass
            q.task_done()

    threads = [threading.Thread(target=worker, daemon=True) for _ in range(workers)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    return found


# --------------------------------------------------------------------------
# Wallets verwalten -- ueber die Kommandozeile, nicht ueber den Dienst
# --------------------------------------------------------------------------
# Bewusst so: die Loopback-Schnittstelle nimmt **nichts** entgegen (nur GET,
# nur lesend). Ein Schreibweg dorthin waere die erste Angriffsflaeche des
# ganzen Programms. Die Wallet-Ansicht zeigt deshalb nur an und nennt den
# Befehl, wenn noch nichts eingetragen ist.
def _lade_sources():
    try:
        with open(SOURCES_FILE) as f:
            return json.load(f) or {}
    except Exception:
        return {}


def _schreibe_sources(cfg):
    os.makedirs(os.path.dirname(SOURCES_FILE), exist_ok=True)
    tmp = SOURCES_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
    # Der xpub ist kein Geheimnis im Sinne von Guthaben, aber er verraet die
    # gesamte Wallet. Also niemandem sonst lesbar.
    os.chmod(tmp, 0o600)
    os.replace(tmp, SOURCES_FILE)


def cmd_watch(argv):
    """--watch-add <xpub> [Name] | --watch-list | --watch-remove <Nr|Name>"""
    cfg = _lade_sources()
    liste = list(cfg.get("watch") or [])

    def zeige():
        if not liste:
            print("Keine Wallet eingetragen.")
            return
        for i, w in enumerate(liste, 1):
            x = w if isinstance(w, str) else w.get("xpub", "")
            name = "" if isinstance(w, str) else (w.get("name") or "")
            try:
                art = Xpub(x).kind
            except Exception as e:
                art = "unlesbar: %s" % e
            print("%d. %-22s %-12s %s…%s" % (i, name or "(ohne Namen)", art,
                                             x[:12], x[-6:]))

    if "--watch-list" in argv:
        zeige()
        return 0

    if "--watch-add" in argv:
        rest = argv[argv.index("--watch-add") + 1:]
        if not rest:
            print("Aufruf: orangedeck --watch-add <xpub|ypub|zpub> [Name]",
                  file=sys.stderr)
            return 2
        xpub = rest[0].strip()
        name = " ".join(rest[1:]).strip()
        # Zuerst pruefen, ob jemand versehentlich einen **privaten** Schluessel
        # einwirft -- dann muss die Meldung darueber reden und nicht ueber eine
        # unbekannte Fassung. Er wird nicht gespeichert und nicht angefasst.
        if xpub[:4].lower() in ("xprv", "yprv", "zprv", "tprv", "uprv", "vprv"):
            print("Das ist ein **privater** Schluessel. Diese Anwendung nimmt "
                  "keine privaten Schluessel entgegen und koennte ohnehin "
                  "nichts damit anfangen -- sie kann nicht signieren. Bitte "
                  "den zugehoerigen xpub/ypub/zpub verwenden.", file=sys.stderr)
            return 1
        try:
            xp = Xpub(xpub)
        except Exception as e:
            print("Das ist kein brauchbarer erweiterter oeffentlicher "
                  "Schluessel: %s" % e, file=sys.stderr)
            return 1
        if any((w if isinstance(w, str) else w.get("xpub")) == xpub for w in liste):
            print("Steht schon drin.", file=sys.stderr)
            return 1
        liste.append({"name": name, "xpub": xpub})
        cfg["watch"] = liste
        _schreibe_sources(cfg)
        print("Eingetragen (%s, Fingerabdruck %s). Erste Empfangsadresse:\n  %s"
              % (xp.kind, xp.fingerprint, xp.address(0, 0)))
        print("\nUebernehmen mit:\n  systemctl --user restart orangedeck")
        return 0

    if "--watch-remove" in argv:
        rest = argv[argv.index("--watch-remove") + 1:]
        if not rest:
            print("Aufruf: orangedeck --watch-remove <Nummer|Name>", file=sys.stderr)
            return 2
        wahl = rest[0]
        vorher = len(liste)
        if wahl.isdigit() and 1 <= int(wahl) <= len(liste):
            del liste[int(wahl) - 1]
        else:
            liste = [w for w in liste
                     if isinstance(w, str) or (w.get("name") or "") != wahl]
        if len(liste) == vorher:
            print("Nichts gefunden.", file=sys.stderr)
            return 1
        cfg["watch"] = liste
        _schreibe_sources(cfg)
        print("Entfernt. Uebernehmen mit:\n  systemctl --user restart orangedeck")
        return 0
    return 2


def cmd_discover(write=False):
    nets = local_networks()
    if not nets:
        print("Kein eigenes /24-Netz gefunden.", file=sys.stderr)
        return 1
    print("Suche in: %s" % ", ".join("%s (%s.0/24)" % (d, p) for d, p in nets),
          file=sys.stderr)
    found = discover_miners()
    if not found:
        print("Kein Miner gefunden. Laeuft das Geraet, und haengt es im selben Netz?",
              file=sys.stderr)
        return 1
    for m in found:
        print("  %-22s %-8s %-18s %s" % (
            m["id"], m["type"], m.get("name") or "",
            ("%.2f TH/s" % (m["hashRate"] / 1e12)) if m.get("hashRate") else ""))
    # stdout ist gepuffert, stderr nicht -- ohne das hier erscheinen die
    # Hinweise vor der Liste.
    sys.stdout.flush()
    if write:
        specs = []
        for m in found:
            if m["type"] == "axeos":
                specs.append({"type": "axeos", "url": m["id"]})
            else:
                host, _, port = m["id"].partition(":")
                specs.append({"type": "cgminer", "host": host, "port": int(port or 4028)})
        cfg = {}
        try:
            with open(SOURCES_FILE) as f:
                cfg = json.load(f) or {}
        except Exception:
            pass
        cfg["miners"] = specs
        os.makedirs(os.path.dirname(SOURCES_FILE), exist_ok=True)
        with open(SOURCES_FILE, "w") as f:
            json.dump(cfg, f, indent=2)
        print("\nIn %s eingetragen. Uebernehmen mit:\n"
              "  systemctl --user restart orangedeck" % SOURCES_FILE, file=sys.stderr)
    else:
        print("\nMit --write in %s eintragen." % SOURCES_FILE, file=sys.stderr)
    return 0


