def load_sources():
    cfg = {}
    try:
        with open(SOURCES_FILE) as f:
            cfg = json.load(f) or {}
    except Exception:
        pass

    miners = list(cfg.get("miners") or [])
    # Kurzform und Umgebungsvariable einreihen
    for short in (cfg.get("bitaxe"), os.environ.get("ORANGEDECK_MINER"),
                  os.environ.get("ORANGEDECK_BITAXE")):
        if short:
            miners.append({"type": "axeos", "url": short})
    # Doppelte entfernen, Reihenfolge erhalten
    seen, out = set(), []
    for m in miners:
        key = (m.get("type"), m.get("url"), m.get("host"), m.get("port"))
        if key not in seen:
            seen.add(key)
            out.append(m)
    cfg["miners"] = out

    # Beobachtete Wallets. Jede ist {"name": "...", "xpub": "..."}; eine
    # blosse Zeichenkette gilt als xpub ohne Namen.
    wallets = []
    for w in (cfg.get("watch") or []):
        if isinstance(w, str):
            w = {"xpub": w}
        if isinstance(w, dict) and w.get("xpub"):
            wallets.append({"name": w.get("name") or "", "xpub": w["xpub"]})
    cfg["watch"] = wallets
    return cfg


