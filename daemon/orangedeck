def mempool_zerlegen(eingabe):
    """Die Eingabe aus dem Feld "Mempool-Instanz" wie `FeedState.basisAus`:
    leer ist mempool.space, ohne Schema https, "/api" am Ende faellt weg.
    Gibt (host, scheme) zurueck; host darf Port und Pfad tragen
    ("umbrel.local:3006", "example.org/mempool"). None bei Unsinn."""
    h = (eingabe or "").strip()
    if not h:
        return ("mempool.space", "https")
    if not re.match(r"^https?://", h, re.I):
        h = "https://" + h
    teile = urlparse(h)
    pfad = re.sub(r"/api(/v1)?/*$", "", teile.path.rstrip("/"), flags=re.I).rstrip("/")
    if teile.scheme.lower() not in ("http", "https") or not teile.netloc:
        return None
    if not re.match(r"^[A-Za-z0-9.\-:\[\]]+$", teile.netloc):
        return None
    if pfad and not re.match(r"^[A-Za-z0-9._~/\-]+$", pfad):
        return None
    return (teile.netloc + pfad, teile.scheme.lower())


def mempool_umstellen(feed, eingabe):
    """Die Instanz wechseln, in sources.json festhalten und neu verbinden.

    Kommt aus `POST /config`, also aus einer Oberflaeche auf diesem Rechner,
    wenn dort das Feld geaendert wurde. Leer entfernt den Eintrag wieder;
    dann gilt ORANGEDECK_HOST oder mempool.space."""
    ziel = mempool_zerlegen(eingabe)
    if ziel is None:
        return False
    roh = {}
    try:
        with open(SOURCES_FILE) as f:
            roh = json.load(f) or {}
    except Exception:
        roh = {}
    if (eingabe or "").strip():
        roh["host"], roh["scheme"] = ziel
    else:
        roh.pop("host", None)
        roh.pop("scheme", None)
        if os.environ.get("ORANGEDECK_HOST"):
            ziel = (os.environ["ORANGEDECK_HOST"],
                    os.environ.get("ORANGEDECK_SCHEME") or "https")
    os.makedirs(os.path.dirname(SOURCES_FILE), exist_ok=True)
    tmp = SOURCES_FILE + ".neu"
    with open(tmp, "w") as f:
        json.dump(roh, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, SOURCES_FILE)
    if (HOST, SCHEME) == ziel:
        return True
    apply_host(*ziel)
    sys.stderr.write("Mempool-Instanz: %s://%s\n" % (SCHEME, HOST))
    # Was von der alten Instanz kam, faellt weg; der WebSocket wird
    # geschlossen, und die Schleife in main() verbindet mit der neuen.
    feed.recent = []
    feed.projected = []
    ws = WS_AKTUELL[0]
    if ws is not None:
        try:
            ws.sock.shutdown(socket.SHUT_RDWR)
        except Exception:
            pass
    return True

