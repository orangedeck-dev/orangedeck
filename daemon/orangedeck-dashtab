def fail(msg):
    print("FEHLER: " + msg, file=sys.stderr)
    sys.exit(1)


def patch_settings(text):
    old = 'readonly property var _dashTabIds: ["overview", "media", "wallpaper", "weather", "settings"]'
    new = 'readonly property var _dashTabIds: ["overview", "media", "wallpaper", "weather", "bitcoin", "settings"]'
    if new in text:
        return text
    if old not in text:
        fail("Ankerpunkt in SettingsData.qml nicht gefunden -- DMS hat sich geaendert.\n"
             "       Gesucht wurde: " + old)
    return text.replace(old, new)


def patch_ipc(text):
    """`dms ipc call dash open bitcoin` und Tastenkuerzel sollen den Tab treffen."""
    if 'case "bitcoin":' in text:
        return text
    old = """            case "weather":
                return "weather";
"""
    new = """            case "weather":
                return "weather";
            case "bitcoin":
                return "bitcoin";
"""
    if old not in text:
        fail("Ankerpunkt in DMSShellIPC.qml nicht gefunden -- DMS hat sich geaendert.")
    return text.replace(old, new, 1)


def patch_popout(text):
    if '"bitcoin"' in text:
        return text

    anchors = [
        # 1. Tab in der Leiste
        ('''            "settings": {
                "icon": "settings",''',
         '''            "bitcoin": {
                "icon": "currency_bitcoin",
                "text": "Bitcoin"
            },
            "settings": {
                "icon": "settings",'''),
        # 2. Hoehe der Seite
        ('''                        if (root.currentTabId === "weather")
                            return weatherLoader.item?.implicitHeight ?? 410;
                        return 410;''',
         '''                        if (root.currentTabId === "weather")
                            return weatherLoader.item?.implicitHeight ?? 410;
                        if (root.currentTabId === "bitcoin")
                            return bitcoinLoader.item?.implicitHeight ?? 410;
                        return 410;'''),
        # 3. aktuelle Seite
        ('''                        if (root.currentTabId === "weather")
                            return weatherLoader.item;
                        return null;''',
         '''                        if (root.currentTabId === "weather")
                            return weatherLoader.item;
                        if (root.currentTabId === "bitcoin")
                            return bitcoinLoader.item;
                        return null;'''),
        # 4. Loader fuer den Inhalt
        ('''                    Loader {
                        id: overviewLoader''',
         '''                    Loader {
                        id: bitcoinLoader
                        anchors.fill: parent
                        active: root.currentTabId === "bitcoin"
                        visible: active
                        sourceComponent: Component {
                            BitcoinTab {}
                        }
                        // `Item.visible` bleibt wahr, wenn das Popout-Fenster
                        // schliesst -- die Sichtbarkeit eines Fensters ist
                        // keine Eigenschaft der Elementkette. Der Popout weiss
                        // es aber selbst, also wird es durchgereicht.
                        onLoaded: {
                            if (item)
                                item.live = Qt.binding(function () {
                                    return root.dashVisible;
                                });
                        }
                    }

                    Loader {
                        id: overviewLoader'''),
    ]
    for old, new in anchors:
        if old not in text:
            fail("Ankerpunkt in DankDashPopout.qml nicht gefunden -- DMS hat sich geaendert.\\n"
                 "       Gesucht wurde:\\n" + old)
        text = text.replace(old, new, 1)
    return text


def dms_version():
    """`dms version` gibt `dms v1.6.1` aus."""
    out = subprocess.run(["dms", "version"], capture_output=True, text=True).stdout
    for word in out.split():
        if word.startswith("v") and word[1:2].isdigit():
            return word
    fail("Version von dms nicht lesbar: " + out.strip())


def read_version(path):
    try:
        with open(os.path.join(path, "VERSION")) as f:
            return f.read().strip()
    except OSError:
        return ""


def ui_source():
    """Liefert ein Verzeichnis mit der DMS-Oberflaeche passend zum Binary."""
    if os.path.isfile(os.path.join(LEGACY_SRC, "shell.qml")):
        return LEGACY_SRC
    ver = dms_version()
    cache = os.path.join(UI_CACHE, ver)
    if read_version(cache) == ver:
        return cache
    for stale in (cache, cache + ".tmp"):
        shutil.rmtree(stale, ignore_errors=True)

    # 1. was die laufende DMS entpackt hat -- bitgleich zum Binary
    run = "/run/user/%d/danklinux-shell" % os.getuid()
    for cand in sorted(glob.glob(os.path.join(run, "*"))):
        if read_version(cand) == ver and os.path.isfile(os.path.join(cand, "shell.qml")):
            shutil.copytree(cand, cache + ".tmp", symlinks=False, dirs_exist_ok=True)
            os.replace(cache + ".tmp", cache)
            print("DMS-Oberflaeche %s aus %s uebernommen" % (ver, cand))
            return cache

    # 2. der passende Git-Tag; DankCommon ist ein Untermodul
    print("DMS-Oberflaeche %s aus %s holen ..." % (ver, DMS_REPO))
    with tempfile.TemporaryDirectory() as tmp:
        repo = os.path.join(tmp, "dms")
        for cmd in (["git", "-c", "advice.detachedHead=false", "clone", "-q",
                     "--depth", "1", "--branch", ver, DMS_REPO, repo],
                    ["git", "-C", repo, "submodule", "update", "--init", "--depth", "1", "-q"]):
            if subprocess.run(cmd).returncode != 0:
                fail("konnte DMS %s nicht holen" % ver)
        # symlinks=False loest DankCommon -> ../dank-qml-common/DankCommon auf
        shutil.copytree(os.path.join(repo, "quickshell"), cache + ".tmp",
                        symlinks=False, dirs_exist_ok=True)
    os.replace(cache + ".tmp", cache)
    if read_version(cache) != ver:
        fail("VERSION in %s passt nicht zu dms %s" % (cache, ver))
    return cache


def mirror(rel):
    """Legt ein Verzeichnis als Symlink-Spiegel des Originals an."""
    src = os.path.join(SRC, rel) if rel else SRC
    dst = os.path.join(DST, rel) if rel else DST
    os.makedirs(dst, exist_ok=True)
    for name in sorted(os.listdir(src)):
        sub = os.path.join(rel, name) if rel else name
        target = os.path.join(dst, name)
        if os.path.islink(target) or os.path.exists(target):
            continue
        if sub in MIRROR:
            mirror(sub)
        else:
            os.symlink(os.path.join(src, name), target)


def dms_active():
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", "dms"]).returncode == 0


def build():
    """Ueberlagerung neu bauen.

    Laeuft DMS, wird es vorher angehalten und danach wieder gestartet: der
    Neubau loescht und ersetzt Dateien, die die laufende Oberflaeche beobachtet
    -- am 16.09.2026 stuerzte Quickshell dabei ab (SIGSEGV in
    QFileSystemWatcher::files())."""
    lief = dms_active()
    if lief:
        print("DMS wird fuer den Neubau angehalten ...", flush=True)
        subprocess.run(["systemctl", "--user", "stop", "dms"], check=False)
    try:
        _build()
    finally:
        if lief:
            subprocess.run(["systemctl", "--user", "start", "dms"], check=False)
            print("DMS wieder gestartet")
        else:
            print("DMS lief nicht -- starten mit:  systemctl --user start dms")


def _build():
    global SRC
    SRC = ui_source()
    if os.path.exists(DST):
        shutil.rmtree(DST)
    mirror("")
    # VERSION erst ganz am Ende schreiben. Die Weiche im Drop-in startet die
    # Ueberlagerung nur mit passender VERSION -- stand sie schon hier und
    # scheiterte danach eine Nachbearbeitung, lief eine halb gepatchte
    # Oberflaeche (Risiko seit 13.09.2026 bekannt). Ohne VERSION startet DMS
    # stattdessen die eingebaute Oberflaeche.
    version_link = os.path.join(DST, "VERSION")
    if os.path.lexists(version_link):
        os.unlink(version_link)

    # gepatchte Dateien als echte Kopien
    dash = os.path.join(DST, "Modules", "DankDash")
    for name, patcher, sub in (
        ("SettingsData.qml", patch_settings, "Common"),
        ("DankDashPopout.qml", patch_popout, os.path.join("Modules", "DankDash")),
        ("DMSShellIPC.qml", patch_ipc, ""),
    ):
        path = os.path.join(DST, sub, name) if sub else os.path.join(DST, name)
        if os.path.islink(path):
            os.unlink(path)
        with open(os.path.join(SRC, sub, name) if sub else os.path.join(SRC, name)) as f:
            text = f.read()
        with open(path, "w") as f:
            f.write(patcher(text))

    # Tab-Inhalt und die geteilten Bausteine daneben legen
    with open(os.path.join(dash, "BitcoinTab.qml"), "w") as f:
        f.write(BITCOIN_TAB)
    # Bewusst aus dem Verzeichnis gelesen statt aufgezaehlt: eine fest
    # verdrahtete Liste vergisst man beim naechsten neuen Baustein, und dann
    # laesst sich FeedPanel hier nicht mehr laden -- der Bitcoin-Tab scheitert
    # und mit ihm das ganze Dashboard. Genau so am 01.09.2026 passiert, als
    # FrostedPanel.qml dazukam.
    for name in sorted(os.listdir(QML)):
        if not (name.endswith(".qml") or name.endswith(".js")):
            continue
        link = os.path.join(dash, name)
        if os.path.islink(link):
            os.unlink(link)
        os.symlink(os.path.join(QML, name), link)

    # Eigene Nachbearbeitungen, die nichts mit OrangeDeck zu tun haben (z. B.
    # Aenderungen an der Leiste). Sie muessen hier laufen, weil jeder Aufruf
    # die Ueberlagerung komplett neu baut und alles andere wegwerfen wuerde.
    hooks = os.path.expanduser("~/.config/orangedeck/dashtab-hooks.d")
    if os.path.isdir(hooks):
        env = dict(os.environ, ORANGEDECK_DMS_DST=DST, ORANGEDECK_DMS_SRC=SRC)
        for name in sorted(os.listdir(hooks)):
            hook = os.path.join(hooks, name)
            if os.path.isfile(hook) and os.access(hook, os.X_OK):
                if subprocess.run([hook], env=env).returncode != 0:
                    fail("Nachbearbeitung %s ist gescheitert -- Ueberlagerung ohne VERSION, "
                         "DMS startet die eingebaute Oberflaeche" % hook)

    # erst jetzt ist die Ueberlagerung vollstaendig
    with open(os.path.join(SRC, "VERSION")) as f:
        version = f.read()
    with open(version_link, "w") as f:
        f.write(version)

    # systemd-Drop-in. Die Weiche faengt ab, was am 12.09.2026 passiert ist:
    # passt die Ueberlagerung nicht zum installierten dms, startet die
    # eingebaute Oberflaeche statt gar keiner. ($$ ist systemds $.)
    os.makedirs(DROPIN_DIR, exist_ok=True)
    with open(DROPIN, "w") as f:
        f.write("# Von orangedeck-dashtab angelegt: DMS aus der Ueberlagerung starten,\n"
                "# bei Versionsabweichung die eingebaute Oberflaeche\n"
                "[Service]\nExecStart=\n"
                "ExecStart=/bin/sh -c 'd=%s; "
                "if [ -f \"$$d/shell.qml\" ] && [ -s \"$$d/VERSION\" ] "
                "&& /usr/bin/dms version 2>/dev/null | grep -qwF \"$$(cat \"$$d/VERSION\")\"; "
                "then exec /usr/bin/dms run --session -c \"$$d\"; "
                "else echo \"orangedeck-dashtab: Ueberlagerung passt nicht zu dms, "
                "starte eingebaute Oberflaeche\" >&2; exec /usr/bin/dms run --session; fi'\n"
                % DST)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
    print("Ueberlagerung liegt in " + DST)


def remove():
    if os.path.exists(DROPIN):
        os.unlink(DROPIN)
    if os.path.exists(DST):
        shutil.rmtree(DST)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
    print("Ueberlagerung entfernt. Neu starten mit:  systemctl --user restart dms")


def check():
    if not os.path.isdir(DST):
        print("keine Ueberlagerung eingerichtet")
        return 1
    ok = True
    have, want = read_version(DST), dms_version()
    if have != want:
        print("veraltet: Ueberlagerung ist %s, dms ist %s" % (have or "ohne Version", want))
        ok = False
    for link in glob.glob(os.path.join(DST, "**"), recursive=True):
        if os.path.islink(link) and not os.path.exists(link):
            print("Verweis ins Leere: " + link)
            ok = False
    print("Ueberlagerung aktuell" if ok else "orangedeck-dashtab erneut aufrufen")
    return 0 if ok else 1


if __name__ == "__main__":
    if "--remove" in sys.argv:
        remove()
    elif "--check" in sys.argv:
        sys.exit(check())
    else:
        build()
