def tx_kind(flags, coinbase=False):
    """Ziffer der Transaktionsart. Rangfolge: was seltener und
    aussagekraeftiger ist, geht vor."""
    if coinbase:
        return 6
    f = int(flags or 0)
    if f & FLAG_COINJOIN:
        return 3
    if f & FLAG_INSCRIPTION:
        return 5
    if f & FLAG_OP_RETURN:
        return 4
    if f & FLAG_CONSOLIDATION:
        return 1
    if f & FLAG_BATCH:
        return 2
    return 0
