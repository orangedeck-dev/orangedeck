def fee_bucket(rate):
    r = rate or 0
    for i, kante in enumerate(FEE_BUCKETS):
        if r < kante:
            return i
    return len(FEE_BUCKETS)


def tile_size(value_sats):
    """Kantenlaenge in Rastereinheiten -- identisch zu logTxSize() in bitfeed
    und tile_size() im Dienst."""
    v = max(1, int(value_sats or 1))
    return min(5, max(1, math.ceil(math.log10(v)) - 5))


def kacheln_aus_summary(txs):
    """Wie summarize_block() im Dienst: je Transaktion Kantenlaenge und
    Gebuehrenklasse, hoechstens MAX_TILES, in der Reihenfolge des Blocks."""
    if not isinstance(txs, list) or not txs:
        return {"tiles": ""}
    step = max(1, len(txs) // MAX_TILES + (1 if len(txs) % MAX_TILES else 0))
    return {"tiles": "".join("%d%d" % (tile_size(txs[i].get("value")), fee_bucket(txs[i].get("rate")))
                             for i in range(0, len(txs), step))}


class Lage:
    """Was ein Befehl bekommt: die Felder, woher sie kamen, wie alt."""

    def __init__(self, felder, quelle, alter=None):
        self.felder = felder
        self.quelle = quelle
        self.alter = alter

    def __getitem__(self, name):
        return self.felder.get(name) or {}


def hole(felder, wahl):
    if wahl in ("auto", "daemon"):
        try:
            zustand = dienst_zustand()
        except DienstFehlt:
            if wahl == "daemon":
                raise Fehler(t("dienst_fehlt", "%s:%d" % dienst_adresse()), 3)
        else:
            frisch = time.time() - (zustand.get("ts") or 0) <= 30
            if frisch and zustand.get("source") != "offline":
                return Lage({f: zustand.get(f) for f in felder + ["vbps"]}, "daemon")
            raise Fehler(t("dienst_offline"), 3)

    speicher = Speicher()
    werte, aeltestes = {}, None
    for f in felder:
        pfad, umformen = DIREKT[f]
        werte[f], alter = speicher.feld(f, pfad, umformen)
        if alter is not None:
            aeltestes = max(aeltestes or 0, alter)
    if aeltestes:
        sys.stderr.write(t("veraltet", dauer(aeltestes)) + "\n")
    return Lage(werte, "direct:" + speicher.host, aeltestes)


