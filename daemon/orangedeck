def _binance_trades(msg):
    """{"e":"aggTrade","T":ms,"p":"81250.1","q":"0.01","m":true}

    `m` heisst "der Kaeufer war der Market Maker" -- der **Angreifer** war dann
    ein Verkaeufer. Die Seite ist also umgekehrt zu dem, was der Name nahelegt.
    """
    if msg.get("e") != "aggTrade":
        return
    try:
        yield (float(msg["T"]) / 1000.0, float(msg["p"]), float(msg["q"]),
               not msg.get("m"))
    except (KeyError, TypeError, ValueError):
        return


def _bybit_trades(msg):
