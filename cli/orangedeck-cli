GRUEN = (90, 200, 130)
ROT = (230, 95, 95)


def ansi_code(rgb, voll, hinten=False):
    """SGR-Teil fuer eine Farbe: Truecolor, sonst der naechste Ton im
    256er-Wuerfel."""
    if voll:
        # Die Klammer um das ganze Tupel ist Pflicht: `%` bindet staerker als
        # `+`. Ohne sie brach am 12.09.2026 jede Truecolor-Ausgabe ab -- die
        # ersten Tests liefen ohne Farbe und sahen es nicht.
        return "%d;2;%d;%d;%d" % (((48 if hinten else 38),) + tuple(rgb))
    stufen = (0, 95, 135, 175, 215, 255)

    def naechste(v):
        return min(range(6), key=lambda i: abs(stufen[i] - v))

    r, g, b = (naechste(v) for v in rgb)
    return "%d;5;%d" % ((48 if hinten else 38), 16 + 36 * r + 6 * g + b)


class Farbe:
    """Farbe nur, wenn sie ankommt: nicht ohne Terminal, nicht bei NO_COLOR
    (no-color.org), nicht bei --color never. Truecolor, wenn das Terminal es
    sagt, sonst der naechste Ton im 256er-Wuerfel."""

    def __init__(self, modus):
        if modus == "always":
            self.an = True
        elif modus == "never":
            self.an = False
        else:
            self.an = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
        self.voll = os.environ.get("COLORTERM", "").lower() in ("truecolor", "24bit")

    def __call__(self, text, rgb, fett=False):
        if not self.an:
            return text
        code = ansi_code(rgb, self.voll)
        if fett:
            code = "1;" + code
        return "\x1b[%sm%s\x1b[0m" % (code, text)


