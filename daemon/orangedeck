def _addr_stats(addr):
    """Salden einer Adresse. Bestaetigt und im Mempool getrennt gezaehlt."""
    d = http_json("/address/%s" % addr, timeout=20)
    c = d.get("chain_stats") or {}
    m = d.get("mempool_stats") or {}
    ein = int(c.get("funded_txo_sum") or 0)
    aus = int(c.get("spent_txo_sum") or 0)
    mein = int(m.get("funded_txo_sum") or 0)
    maus = int(m.get("spent_txo_sum") or 0)
    return {
        "n": int(c.get("tx_count") or 0) + int(m.get("tx_count") or 0),
        "bal": ein - aus + mein - maus,
        "in": ein + mein,
        "out": aus + maus,
        "pend": mein - maus,
    }


def _kette_abtasten(xp, kette, halt):
    """Eine Kette bis zur Luecke abtasten. Gibt die benutzten Adressen und die
    naechste unbenutzte zurueck."""
    benutzt, leer, i, naechste = [], 0, 0, None
    while leer < WATCH_GAP and i < WATCH_MAX_ADDR:
        if halt():
            break
        adr = xp.address(kette, i)
        st = _addr_stats(adr)
        if st["n"] > 0:
            benutzt.append(dict(st, a=adr, c=kette, i=i))
            leer = 0
        else:
            if naechste is None:
                naechste = adr
            leer += 1
        i += 1
        time.sleep(WATCH_SPACING)
    return benutzt, (naechste or xp.address(kette, i))


def _wallet_txs(adressen, eigene):
    """Die juengsten Transaktionen der Wallet, zusammengefuehrt ueber die
    benutzten Adressen. Der Betrag ist die Aenderung **fuer die Wallet**: was
    auf eigene Adressen zufliesst, minus was von eigenen abfliesst."""
    gesehen, out = {}, []
    for st in adressen[:WATCH_TX_REQUESTS]:
        try:
            txs = http_json("/address/%s/txs" % st["a"], timeout=25)
        except Exception:
            continue
        for t in txs or []:
            tid = t.get("txid")
            if not tid or tid in gesehen:
                continue
            gesehen[tid] = True
            zu = sum(int(o.get("value") or 0) for o in (t.get("vout") or [])
                     if o.get("scriptpubkey_address") in eigene)
            ab = sum(int((v.get("prevout") or {}).get("value") or 0)
                     for v in (t.get("vin") or [])
                     if ((v.get("prevout") or {}).get("scriptpubkey_address")) in eigene)
            st_ = t.get("status") or {}
            out.append({
                "t": tid,
                "d": zu - ab,
                "h": int(st_.get("block_height") or 0),
                "ts": int(st_.get("block_time") or 0),
                "f": int(t.get("fee") or 0),
                "ok": bool(st_.get("confirmed")),
            })
        time.sleep(WATCH_SPACING)
    # Unbestaetigtes zuerst, danach nach Hoehe absteigend
    out.sort(key=lambda x: (x["ok"], x["h"]), reverse=True)
    return out[:WATCH_TX_KEEP]


def scan_wallet(cfg, halt):
    """Eine Wallet vollstaendig abtasten. Gibt den Eintrag fuer den Zustand
    zurueck -- auch im Fehlerfall, dann mit `error`."""
    name = cfg.get("name") or ""
    try:
        xp = Xpub(cfg["xpub"])
    except Exception as e:
        return {"name": name, "error": str(e), "kind": "", "addresses": [],
                "txs": [], "balance": 0}

    empfang, naechstEmpfang = _kette_abtasten(xp, 0, halt)
    wechsel, naechstWechsel = _kette_abtasten(xp, 1, halt)
    benutzt = empfang + wechsel
    eigene = set(a["a"] for a in benutzt)
    eigene.add(naechstEmpfang)
    eigene.add(naechstWechsel)

    # Nach Aktivitaet sortiert -- danach wird gefragt, wer etwas zu erzaehlen hat
    nach_txs = sorted(benutzt, key=lambda a: -a["n"])
    txs = [] if halt() else _wallet_txs(nach_txs, eigene)

    return {
        "name": name or ("Wallet " + xp.fingerprint),
        "kind": xp.kind,
        "fingerprint": xp.fingerprint,
        "balance": sum(a["bal"] for a in benutzt),
        "received": sum(a["in"] for a in benutzt),
        "sent": sum(a["out"] for a in benutzt),
        "pending": sum(a["pend"] for a in benutzt),
        "txCount": sum(a["n"] for a in benutzt),
        "used": len(benutzt),
        "nextRecv": naechstEmpfang,
        "nextChange": naechstWechsel,
        # Nur benutzte Adressen -- unbenutzte gibt es unbegrenzt viele
        "addresses": [{"a": a["a"], "c": a["c"], "i": a["i"],
                       "bal": a["bal"], "n": a["n"]} for a in benutzt],
        "txs": txs,
        "scannedAt": round(time.time(), 2),
        "error": "",
    }


def poll_watch(feed):
    """Alle beobachteten Wallets abtasten, wenn es Zeit ist.

    Laeuft nebenher und dauert je nach Groesse eine halbe Minute -- die
    Abfragen sind bewusst auseinandergezogen."""
    wallets = SOURCES.get("watch") or []
    if not wallets:
        if feed.wallets:
            feed.slow_rev += 1
            feed.wallets = []
            feed.dirty = True
        return
    now = time.time()
    if now < feed.watch_at and not feed.watch_now:
        return
    feed.watch_now = False
    feed.watch_at = now + WATCH_INTERVAL
    feed.watch_busy = True
    try:
        halt = lambda: feed.watch_stop
        out = [scan_wallet(w, halt) for w in wallets]
        feed.slow_rev += 1
        feed.wallets = out
        # Fuer die Halde: eigene Transaktionen werden hervorgehoben
        ids = set()
        for w in out:
            for t in w.get("txs") or []:
                ids.add(t["t"])
        feed.watch_txids = ids
        feed.dirty = True
    finally:
        feed.watch_busy = False


def run_watch(feed):
    """Die Wallets bekommen einen **eigenen** Faden.

    Ein Abtastlauf dauert je nach Groesse eine halbe Minute und mehr -- die
    Abfragen sind absichtlich auseinandergezogen. Im Faden der uebrigen
    Nebenquellen wuerde er die Mempool-Kurve loechrig machen und die
    Miner-Abfrage anhalten."""
    while True:
        try:
            poll_watch(feed)
        except Exception as e:
            sys.stderr.write("Wallets: %s\n" % e)
            feed.watch_busy = False
        time.sleep(2)


def run_extras(feed):
    """Die langsamen Quellen laufen **nebenher**. Im WebSocket-Faden haetten
    ihre HTTP-Abfragen den Feed bis zu 15 Sekunden angehalten -- die Schleife
    dort blockiert ja auf `ws.recv()`."""
    while True:
        try:
            sample_stats(feed)
            poll_slow(feed)
            poll_miners(feed)
        except Exception as e:
            sys.stderr.write("Nebenquellen: %s\n" % e)
        time.sleep(1)


def poll_rest(feed):
    """Notbetrieb ohne WebSocket -- deutlich grober, aber die Ansicht lebt."""
    feed.source = "rest"
    try:
        info = http_json("/mempool")
        feed.set_mempool({"size": info.get("count"), "bytes": info.get("vsize"),
                          "total_fee": (info.get("total_fee") or 0) / 1e8})
    except Exception as e:
        feed.error = f"mempool: {e}"
    try:
        feed.add_txs(http_json("/mempool/recent") or [])
    except Exception:
        pass
    try:
        f = http_json("/v1/fees/recommended")
        feed.fees = {"fastest": f.get("fastestFee"), "halfHour": f.get("halfHourFee"),
                     "hour": f.get("hourFee"), "economy": f.get("economyFee"),
                     "minimum": f.get("minimumFee")}
    except Exception:
        pass
    try:
        blocks = http_json("/v1/blocks")
        if blocks:
            prev = feed.tip.get("height")
            feed.set_tip(blocks[0], is_new=bool(prev and blocks[0].get("height") != prev))
    except Exception:
        pass
    feed.write()


def acquire_lock():
    """Nur eine Instanz schreibt den Zustand. Liefert das offene Lock-Objekt
    oder None, wenn schon jemand laeuft."""
    os.makedirs(STATE_DIR, exist_ok=True)
    fh = open(LOCK_FILE, "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return None
    fh.write(str(os.getpid()))
    fh.flush()
    return fh


def main():
    args = set(sys.argv[1:])

    if "--discover-miners" in args:
        return cmd_discover(write="--write" in args)

    if args & {"--watch-add", "--watch-list", "--watch-remove"}:
        return cmd_watch(sys.argv[1:])

    for kind in ("waybar", "polybar", "genmon"):
        if "--" + kind in args:
            return emit_bar(kind)

    feed = Feed()

    if "--once" in args or "--print" in args:
        poll_rest(feed)
        poll_slow(feed)
        poll_miners(feed)
        if "--print" in args:
            print(json.dumps(feed.snapshot(), indent=2))
        return 0

    lock = acquire_lock()
    if lock is None:
        print("orangedeck laeuft bereits -- diese Instanz beendet sich.", file=sys.stderr)
        return 0

    _feed_ref[0] = feed
    serve_local(feed)
    threading.Thread(target=run_extras, args=(feed,), daemon=True).start()
    threading.Thread(target=run_watch, args=(feed,), daemon=True).start()
    # Ein Faden je Boerse. Sie schlafen, bis jemand den Markt-Reiter oeffnet.
    for _quelle in MARKETS:
        threading.Thread(target=run_market, args=(_quelle,), daemon=True).start()
    LIQ.laden()
    for _quelle in LIQUIDATIONEN:
        threading.Thread(target=run_liquidationen, args=(_quelle,),
                         daemon=True).start()
    threading.Thread(target=run_liq_sichern, daemon=True).start()

    backoff = 2
    rest_deadline = 0.0
    while True:
        try:
            run_ws(feed)
            backoff = 2
        except KeyboardInterrupt:
            return 0
        except Exception as e:
            feed.source = "offline"
            feed.error = f"{type(e).__name__}: {e}"
            feed.dirty = True
            try:
                feed.write()
            except Exception:
                pass
            # Waehrend der Wartezeit wenigstens per REST am Leben halten
            end = time.time() + backoff
            while time.time() < end:
                if time.time() >= rest_deadline:
                    try:
                        poll_rest(feed)
                        feed.error = f"WebSocket weg, REST-Notbetrieb: {e}"
                    except Exception:
                        pass
                    rest_deadline = time.time() + 15
                time.sleep(1)
            backoff = min(backoff * 2, 60)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
