    if not str(msg.get("topic", "")).startswith("publicTrade"):
        return
    for t in msg.get("data") or []:
        try:
            yield (float(t["T"]) / 1000.0, float(t["p"]), float(t["v"]),
                   t.get("S") == "Buy")
        except (KeyError, TypeError, ValueError):
