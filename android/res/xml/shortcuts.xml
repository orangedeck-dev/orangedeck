<?xml version="1.0" encoding="utf-8"?>
<!-- Eine Verknuepfung je Ansicht: langer Druck auf das Symbol, dann von dort
     auf den Startbildschirm ziehen. So bekommt jeder Reiter sein eigenes
     Symbol, ohne dass es ein Homescreen-Widget waere — das ist auf Android
     etwas voellig anderes (RemoteViews, kein QML) und um Groessenordnungen
     aufwendiger.

     **Hoechstens vier.** Android: "Most supported launchers display up to
     four shortcuts at a time, including both static and dynamic shortcuts."
     Was darueber hinaus deklariert wird, faellt stillschweigend weg.

     **Es sind aber nur drei, und der Grund steckt in der Anwendung.** Auf
     Android laeuft der Direktbezug; einen Dienst gibt es dort nicht. Miner,
     Wallet (bis 26.09.2026) und **Markt** haengen an ihm und haben auf dem
     Geraet nie einen Reiter. Eine Verknuepfung dorthin fuehrte im Emulator am 05.09.2026 auf
     eine vollstaendig leere Seite. Uebrig bleiben Feed, Uhr und Explorer.

     **Je eine eigene `android:action`, keine Extras.** Ein statisches
     `<intent>` traegt keine `<extra>`-Kinder — dokumentiert sind nur
     `action`, `targetPackage` und `targetClass`. Die Ansicht steckt deshalb
     in der Aktion selbst, und `main.cpp` liest sie beim Start aus. Der
     `targetClass` macht die Absicht ausserdem ausdruecklich: sie kann bei
     keiner anderen Anwendung landen. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="feed"
        android:enabled="true"
        android:icon="@drawable/shortcut_feed"
        android:shortcutShortLabel="@string/shortcut_feed_short"
        android:shortcutLongLabel="@string/shortcut_feed_long">
        <intent
            android:action="dev.orangedeck.OrangeDeck.VIEW_FEED"
            android:targetPackage="dev.orangedeck.OrangeDeck"
            android:targetClass="org.qtproject.qt.android.bindings.QtActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="clock"
        android:enabled="true"
        android:icon="@drawable/shortcut_clock"
        android:shortcutShortLabel="@string/shortcut_clock_short"
        android:shortcutLongLabel="@string/shortcut_clock_long">
        <intent
            android:action="dev.orangedeck.OrangeDeck.VIEW_CLOCK"
            android:targetPackage="dev.orangedeck.OrangeDeck"
            android:targetClass="org.qtproject.qt.android.bindings.QtActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="explorer"
        android:enabled="true"
        android:icon="@drawable/shortcut_explorer"
        android:shortcutShortLabel="@string/shortcut_explorer_short"
        android:shortcutLongLabel="@string/shortcut_explorer_long">
        <intent
            android:action="dev.orangedeck.OrangeDeck.VIEW_EXPLORER"
            android:targetPackage="dev.orangedeck.OrangeDeck"
            android:targetClass="org.qtproject.qt.android.bindings.QtActivity" />
    </shortcut>
</shortcuts>
