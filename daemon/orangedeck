class Liquidationen:
    """Zwangsliquidationen, wie sie hereinkommen.

    **Es gibt sie fast nur live.** Binance hat `allForceOrders` abgeschaltet,
    Bybit hat keinen Weg zurueck. OKX liefert per REST rund den letzten Tag
    (`liq_nachholen`, seit dem 15.09.2026; vorher stand hier, auch OKX habe
    keinen). Alles Aeltere hat der Dienst selbst gehoert, oder es fehlt: ein
    Fenster im Jahr 2021 bleibt zwangslaeufig leer. Das ist keine Luecke
    im Bau, sondern die Datenlage, und die Oberflaeche sagt es auch so.

    Gehalten wird nach Zeit, nicht nach Anzahl: an einem ruhigen Tag sind das
    ein paar Dutzend, in einer Stunde Panik tausende. Ein Ring fester Laenge
    wuerde im ersten Fall Tage abdecken und im zweiten Minuten.
    """

    def __init__(self):
        self.lock = threading.Lock()
        # [ts, preis, menge, istLong, quelle] -- juengste zuletzt
        self.liste = collections.deque(maxlen=LIQ_KEEP)
        self.online = {}
        self.gesehen = set()
        # Seit wann ueberhaupt zugehoert wird. **Eine obere Schranke der
        # Abdeckung**, keine Zusage: die Stroeme laufen nur, solange jemand
        # hinsieht, also kann es danach Luecken geben. Vor diesem Zeitpunkt
        # gibt es aber sicher nichts, und genau das muss die Oberflaeche
        # sagen koennen -- sonst sieht eine leere Spur aus wie ein Fehler.
        self.seit = 0.0
        self.schmutzig = False

    def add(self, ts, preis, menge, ist_long, quelle=""):
        if preis <= 0 or menge <= 0:
            return
        # **OKX schiebt beim Verbinden Zurueckliegendes nach** -- gemessen
        # Zeitstempel, die vierzig Minuten alt waren. Ohne Sperre stuenden
        # dieselben Marken nach jedem Neuverbinden ein zweites Mal im Bild.
        schluessel = (round(ts, 3), round(preis, 2), round(menge, 6), quelle)
        with self.lock:
            if schluessel in self.gesehen:
                return
            self.gesehen.add(schluessel)
            if len(self.gesehen) > LIQ_KEEP * 2:
                self.gesehen.clear()
            self.liste.append([round(ts, 2), round(preis, 2), round(menge, 6),
                               1 if ist_long else 0, quelle])
            self.schmutzig = True
            grenze = time.time() - LIQ_SEKUNDEN
            while self.liste and self.liste[0][0] < grenze:
                self.liste.popleft()
            # Was vor der Grenze lag, ist weg -- also ist auch `seit` nicht
            # aelter. Bis zum 16.09.2026 stand dort weiter der 04.09., und
            # die Ansicht sagte "zugehoert seit" ueber zwei Tagen Daten.
            if self.seit and self.seit < grenze:
                self.seit = grenze

    def ordnen(self):
        """Wieder nach Zeit sortieren. Nachgeholtes ist aelter als das, was
        der Strom schon brachte, und das Kuerzen in `add` schaut nur vorne."""
        with self.lock:
            sortiert = sorted(self.liste, key=lambda x: x[0])
            self.liste.clear()
            self.liste.extend(sortiert)

    def fenster(self, von, bis, hoechstens=400):
        """Was in einem Zeitfenster liegt -- die groessten zuerst begrenzt.

        Bei einem Sturz gibt es mehr Marken als Bildpunkte. Gezeigt werden
        dann die **groessten**: eine Liquidation ueber zehn Millionen sagt
        etwas, tausend zu je zweihundert Dollar sagen dasselbe einmal.
        """
        with self.lock:
            drin = [x for x in self.liste if von <= x[0] <= bis]
        if len(drin) > hoechstens:
            drin.sort(key=lambda x: x[1] * x[2], reverse=True)
            drin = drin[:hoechstens]
            drin.sort(key=lambda x: x[0])
        return drin


    def histogramm(self, von, bis, tief, hoch, stufen=24):
        """Wieviel Dollar je Preisstufe liquidiert wurde.

        **Der eigentliche Zweck der Sammlung.** Die Einzelmarken beantworten
        "wann", das Histogramm beantwortet "wo" -- und das ist die Frage, die
        vor dem Kurs steht: wo lagen die Positionen, die aufgeben mussten.

        Aufgeteilt wird ueber die Preisspanne, die auch im Bild steht. Eine
        eigene Skala waere ein zweites Koordinatensystem in derselben
        Flaeche.
        """
        if hoch <= tief or stufen < 2:
            return []
        breite = (hoch - tief) / stufen
        eimer = [[0.0, 0.0] for _ in range(stufen)]
        with self.lock:
            drin = [x for x in self.liste if von <= x[0] <= bis]
        for ts, preis, menge, ist_long, _q in drin:
            if preis < tief or preis > hoch:
                continue
            i = min(stufen - 1, int((preis - tief) / breite))
            eimer[i][0 if ist_long else 1] += preis * menge
        # **Auch die leeren Stufen gehen mit.** Wer nur die vollen schickt,
        # macht aus der Preisachse eine Liste: die Oberflaeche verteilt dann
        # zwei Treffer ueber die halbe Flaeche, und die Hoehe im Bild sagt
        # nichts mehr ueber den Preis. Eine Achse hat gleiche Abstaende oder
        # sie ist keine.
        return [[round(tief + (i + 0.5) * breite, 2), round(lang), round(kurz)]
                for i, (lang, kurz) in enumerate(eimer)]


    def laden(self):
        """Was frueher gehoert wurde, zurueckholen."""
        try:
            with open(LIQ_FILE) as f:
                d = json.load(f)
        except (OSError, ValueError):
            return
        grenze = time.time() - LIQ_SEKUNDEN
        with self.lock:
            for x in d.get("liste") or []:
                try:
                    if float(x[0]) >= grenze:
                        self.liste.append(x)
                except (IndexError, TypeError, ValueError):
                    continue
            self.seit = float(d.get("seit") or 0.0)
            # Die Datei kann aelter sein als das, was von ihr bleibt
            if self.seit and self.seit < grenze:
                self.seit = grenze

    def sichern(self):
        if not self.schmutzig:
            return
        with self.lock:
            d = {"seit": round(self.seit), "liste": list(self.liste)}
            self.schmutzig = False
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = LIQ_FILE + ".tmp"
            with open(tmp, "w") as f:
                json.dump(d, f, separators=(",", ":"))
            os.replace(tmp, LIQ_FILE)
        except OSError as e:
            sys.stderr.write("Liquidationen nicht zu sichern: %s\n" % e)


