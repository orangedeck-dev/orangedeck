def parse_xpub(text):
    raw = b58check_decode(text.strip())
    if len(raw) != 78:
        raise ValueError("kein erweiterter Schluessel")
    version = int.from_bytes(raw[0:4], "big")
    kind = XPUB_KINDS.get(version)
    if kind is None:
        raise ValueError("unbekannte Fassung -- erwartet wird xpub, ypub oder zpub")
    key = raw[45:78]
    if key[0] not in (2, 3):
        raise ValueError("das ist kein oeffentlicher Schluessel")
    return {"kind": kind, "chain": raw[13:45], "key": key,
            "depth": raw[4], "fingerprint": raw[5:9].hex()}


def ckd_pub(key, chain, index):
    """CKDpub aus BIP32. Nur nicht gehaertet -- gehaertet ginge oeffentlich
    ohnehin nicht, und genau das ist hier erwuenscht."""
    if index >= 0x80000000:
        raise ValueError("gehaertete Ableitung geht ohne privaten Schluessel nicht")
    data = key + index.to_bytes(4, "big")
    I = hmac.new(chain, data, hashlib.sha512).digest()
    left = int.from_bytes(I[:32], "big")
    if left >= _N:
        raise ValueError("ungueltiger Schritt")     # Wahrscheinlichkeit ~2^-127
    point = _add(_mul(left, _G), _decompress(key))
    if point is None:
        raise ValueError("ungueltiger Schritt")
    return _compress(point), I[32:]


def address_for(kind, pubkey):
    h = hash160(pubkey)
    if kind == "p2pkh":
        return b58check_encode(b"\x00" + h)
    if kind == "p2sh-p2wpkh":
        return b58check_encode(b"\x05" + hash160(b"\x00\x14" + h))
    if kind == "p2wpkh":
        return bech32_address("bc", 0, h)
    raise ValueError("unbekannte Adressform")


class Xpub:
    """Ein erweiterter oeffentlicher Schluessel, bereit zum Ableiten.

    Die Zwischenstufe m/<kette> wird einmal gerechnet und behalten -- ohne das
    kostet jede Adresse zwei Punktmultiplikationen statt einer."""

    def __init__(self, text):
        info = parse_xpub(text)
        self.kind = info["kind"]
        self.fingerprint = info["fingerprint"]
        self._ketten = {}
        self._key = info["key"]
        self._chain = info["chain"]

    def _kette(self, nr):
        if nr not in self._ketten:
            self._ketten[nr] = ckd_pub(self._key, self._chain, nr)
        return self._ketten[nr]

    def address(self, kette, index):
        key, cc = self._kette(kette)
        k, _ = ckd_pub(key, cc, index)
        return address_for(self.kind, k)


# --------------------------------------------------------------------------
# Minimaler WebSocket-Client (RFC 6455, nur was hier gebraucht wird)
# --------------------------------------------------------------------------
class WSError(Exception):
    pass


class WebSocket:
    def __init__(self, url, origin=None, timeout=45):
        u = urlparse(url)
        secure = u.scheme in ("wss", "https")
        port = u.port or (443 if secure else 80)
        path = (u.path or "/") + (("?" + u.query) if u.query else "")
        self._buf = b""
        raw = socket.create_connection((u.hostname, port), timeout=20)
        raw.settimeout(timeout)
        if secure:
            self.sock = ssl.create_default_context().wrap_socket(
                raw, server_hostname=u.hostname)
        else:
            self.sock = raw
        key = base64.b64encode(os.urandom(16)).decode()
        req = (f"GET {path} HTTP/1.1\r\nHost: {u.hostname}\r\n"
               "Upgrade: websocket\r\nConnection: Upgrade\r\n"
               f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n"
               f"User-Agent: {UA}\r\n"
               + (f"Origin: {origin}\r\n" if origin else "") + "\r\n")
        self.sock.sendall(req.encode())
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise WSError("Verbindung beim Handshake geschlossen")
            head += chunk
            if len(head) > 65536:
                raise WSError("Handshake-Antwort zu gross")
        header, _, rest = head.partition(b"\r\n\r\n")
        status = header.split(b"\r\n", 1)[0].decode(errors="replace")
        if "101" not in status:
            raise WSError(f"Handshake fehlgeschlagen: {status}")
        accept = base64.b64encode(hashlib.sha1(
            (key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
        if accept.encode() not in header:
            raise WSError("Sec-WebSocket-Accept passt nicht")
        self._buf = rest

    def _read(self, n):
        while len(self._buf) < n:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise WSError("Verbindung geschlossen")
            self._buf += chunk
        out, self._buf = self._buf[:n], self._buf[n:]
        return out

    def _frame(self, opcode, payload=b""):
        n = len(payload)
        head = bytes([0x80 | opcode])
        if n < 126:
            head += bytes([0x80 | n])
        elif n < 65536:
            head += bytes([0x80 | 126]) + struct.pack(">H", n)
        else:
            head += bytes([0x80 | 127]) + struct.pack(">Q", n)
        mask = os.urandom(4)
        self.sock.sendall(head + mask
                          + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))

    def send(self, text):
        self._frame(0x1, text.encode())

    def recv(self):
        """Naechster Textrahmen als str; Ping/Close werden intern behandelt."""
        frags, frag_op = [], None
        while True:
            b0, b1 = self._read(2)
            fin, opcode, n = b0 & 0x80, b0 & 0x0F, b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8))[0]
            if b1 & 0x80:
                mask = self._read(4)
                data = bytes(b ^ mask[i % 4] for i, b in enumerate(self._read(n)))
            else:
                data = self._read(n)
            if opcode == 0x8:
                self._frame(0x8, data[:2])
                raise WSError("Server hat die Verbindung geschlossen")
            if opcode == 0x9:
                self._frame(0xA, data)
                continue
            if opcode == 0xA:
                continue
            if opcode == 0x0:
                frags.append(data)
            else:
                frags, frag_op = [data], opcode
            if fin:
                return b"".join(frags).decode("utf-8", "replace") if frag_op == 0x1 else None

    def close(self):
        try:
            self._frame(0x8, struct.pack(">H", 1000))
        except Exception:
            pass
        try:
            self.sock.close()
        except Exception:
            pass


def summarize_block(bid, base=None):
    """Holt die Transaktionsliste eines Blocks und bereitet die Kacheldaten auf.

    Aus jeder Transaktion werden nur zwei Ziffern gespeichert: Kantenlaenge
    (1-5) und Gebuehrenklasse (0-9). Ein voller Block sind damit rund 8 kB
    statt 700 kB. Die Reihenfolge bleibt die des Blocks.

    Dieselbe Aufbereitung dient dem laufenden Feed **und** dem Explorer -- die
    Kachelgrafik ist in beiden Faellen dieselbe."""
    txs = http_json("/v1/block/%s/summary" % bid, timeout=40)
    if not isinstance(txs, list) or not txs:
        return None

    step = max(1, len(txs) // MAX_TILES + (1 if len(txs) % MAX_TILES else 0))
    tiles = []
    total_value = 0
    total_fee = 0
    total_vsize = 0.0
    for t in txs:
        total_value += int(t.get("value") or 0)
        total_fee += int(t.get("fee") or 0)
        total_vsize += float(t.get("vsize") or 0)
    # Kacheln (zwei Ziffern je Transaktion) und die Angaben fuer den Tooltip.
    # Beide werden mit demselben Schritt abgetastet, damit die Indizes passen.
    details = []
    kinds = []
    for i in range(0, len(txs), step):
        t = txs[i]
        tiles.append("%d%d" % (tile_size(t.get("value")), fee_bucket(t.get("rate"))))
        # Die erste Transaktion eines Blocks ist die Blockbelohnung. Am
        # Bitfeld ist sie nicht zu erkennen -- an ihrer Lage schon.
        kinds.append("%d" % tx_kind(t.get("flags"), coinbase=(i == 0)))
        details.append([
            t.get("txid") or "",
            round(float(t.get("vsize") or 0), 2),
            int(t.get("fee") or 0),
            int(t.get("value") or 0),
            round(float(t.get("rate") or 0), 3),
        ])

    data = dict(base or {})
    data.update({
        "totalValue": total_value,
        "sumFees": total_fee,
        "avgFeeRate": round(total_fee / total_vsize, 3) if total_vsize else 0,
        "tileStep": step,
        "tiles": "".join(tiles),
        "types": "".join(kinds),
        "txs": details,
    })
    return data


def write_block_summary(tip):
    """Legt die Kacheldaten des zuletzt gefundenen Blocks fuer den Feed ab."""
    bid = tip.get("id")
    if not bid:
        return
    data = summarize_block(bid, tip)
    if not data:
        return
    tmp = BLOCK_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, separators=(",", ":"))
    os.replace(tmp, BLOCK_FILE)


def http_json(path, timeout=15):
    req = urllib.request.Request(API + path, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())


