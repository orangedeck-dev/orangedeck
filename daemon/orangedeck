def verhaeltnis():
    """Wie viele Konten long stehen und wie viele short, je Boerse.

    **Echte Zahlen der Boersen**, keine Schaetzung -- im Unterschied zu einer
    Liquidations-Heatmap, die es nirgends frei gibt. Drei Quellen, alle ohne
    Schluessel, alle in rund einer Sekunde.

    Bemerkenswert: **Binance antwortet hier**, obwohl sein Futures-WebSocket
    von dieser Leitung aus stumm bleibt (Handshake 101, dann null Bytes in
    zwoelf Sekunden -- auf Byte-Ebene nachgemessen, mit und ohne
    Browser-Kennung, waehrend der Spot-Strom im selben Test 26 kB lieferte).
    Gesperrt ist also der Strom, nicht die Boerse.

    Alle drei nennen einen **Konten**-Anteil, nicht einen Kapitalanteil: 52 %
    long heisst, dass jedes zweite Konto long steht, nicht dass dort das halbe
    Geld liegt. Das gehoert dazugesagt, sonst liest man es als Uebergewicht.

    Fuenf Minuten Puffer -- die Boersen rechnen selbst nur alle fuenf Minuten
    neu.
    """
    global _verhaeltnis
    with _verhaeltnis_lock:
        wann, daten = _verhaeltnis
        if daten and time.time() - wann < 300:
            return daten
    aus = []
    try:
        d = _hol_json("https://www.okx.com/api/v5/rubik/stat/contracts/"
                      "long-short-account-ratio?ccy=BTC&period=5m")
        reihe = (d.get("data") or [])[0]
        # OKX gibt das Verhaeltnis long/short, nicht die Anteile
        v = float(reihe[1])
        aus.append({"id": "okx", "name": "OKX", "long": v / (1.0 + v)})
    except Exception as e:
        sys.stderr.write("Verhaeltnis okx: %s\n" % e)
    try:
        d = _hol_json("https://api.bybit.com/v5/market/account-ratio"
                      "?category=linear&symbol=BTCUSDT&period=5min&limit=1")
        r = ((d.get("result") or {}).get("list") or [])[0]
        aus.append({"id": "bybit", "name": "Bybit", "long": float(r["buyRatio"])})
    except Exception as e:
        sys.stderr.write("Verhaeltnis bybit: %s\n" % e)
    try:
        d = _hol_json("https://fapi.binance.com/futures/data/"
                      "globalLongShortAccountRatio?symbol=BTCUSDT&period=5m&limit=1")
        aus.append({"id": "binance", "name": "Binance",
                    "long": float(d[-1]["longAccount"])})
    except Exception as e:
        sys.stderr.write("Verhaeltnis binance: %s\n" % e)
    for x in aus:
        x["long"] = round(max(0.0, min(1.0, x["long"])), 4)
    if not aus:
        with _verhaeltnis_lock:
            _wann, alt = _verhaeltnis
        return alt
    with _verhaeltnis_lock:
        _verhaeltnis = (time.time(), aus)
    return aus


# --------------------------------------------------------------------------
# Liquidations-Heatmap -- ein **Modell**, keine Messung
# --------------------------------------------------------------------------
# Was Coinglass unter diesem Namen zeigt, ist hochgerechnet: aus dem offenen
# Interesse und *angenommenen* Hebeln wird abgeleitet, wo Positionen liegen
# und bei welchem Kurs sie sterben wuerden. Ihr eigenes Feld heisst
# `liquidation_leverage_data`, nicht `liquidation_data`.
#
# Ihre Schnittstelle dafuer kostet 699 $ im Monat (Professional-Tarif, ohne
# Schluessel kommt `{"code":"401","msg":"API key missing."}`). Die **Zutaten**
# sind aber frei: den Verlauf des offenen Interesses geben Binance, OKX und
# Bybit ohne Schluessel heraus. Also wird hier selbst gerechnet.
#
# **Zwei Annahmen stecken darin, und beide sind erfunden**, nicht gemessen:
# die Verteilung der Hebel und die Aufteilung zwischen Long und Short. Sie
# stehen deshalb hier oben als Konstanten, und die Oberflaeche nennt sie.
# Niemand veroeffentlicht, mit welchem Hebel fremde Positionen laufen.
HEBEL_STUFEN = ((5, 0.30), (10, 0.30), (25, 0.20), (50, 0.13), (100, 0.07))
# Halb long, halb short. Das Konten-Verhaeltnis waere die naechstliegende
# Verfeinerung -- es zaehlt aber **Konten**, nicht Kapital, und waere damit
# eine zweite Annahme auf der ersten.
LONG_ANTEIL = 0.5
# Binance haelt den Verlauf des offenen Interesses **dreissig Tage** vor
# (gemessen: 5m reicht 1,7 Tage, 1h 20,8 Tage, 1d 30,0 Tage). Fuer laengere
# Fenster gibt es das Modell schlicht nicht.
OI_RASTER = (("5m", 300), ("15m", 900), ("30m", 1800), ("1h", 3600),
             ("2h", 7200), ("4h", 14400), ("6h", 21600), ("12h", 43200),
             ("1d", 86400))
OI_MAX_TAGE = 30

_oi_lock = threading.Lock()
_oi = {}   # raster -> (zeitpunkt, {sekunde: offenes Interesse in BTC})


def offenes_interesse(raster):
    """Verlauf des offenen Interesses, gepuffert."""
    with _oi_lock:
        eintrag = _oi.get(raster)
        if eintrag and time.time() - eintrag[0] < 240:
            return eintrag[1]
    try:
        roh = _hol_json("https://fapi.binance.com/futures/data/openInterestHist"
                        "?symbol=BTCUSDT&period=%s&limit=500" % raster, timeout=20)
        d = {int(x["timestamp"]) // 1000: float(x["sumOpenInterest"]) for x in roh}
    except Exception as e:
        sys.stderr.write("Offenes Interesse %s: %s\n" % (raster, e))
        with _oi_lock:
            eintrag = _oi.get(raster)
        return eintrag[1] if eintrag else {}
    with _oi_lock:
        _oi[raster] = (time.time(), d)
    return d


def heatmap(kerzen, stufen=64, schwelle=0.004):
    """Wo Positionen liegen wuerden, ueber die Zeit.

    Der Gedanke in drei Schritten:

    1. **Waechst das offene Interesse, wurden Positionen eroeffnet** -- und
       zwar zum Kurs, der gerade galt. Faellt es, wurden welche geschlossen;
       das interessiert hier nicht.
    2. Eine Long-Position mit Hebel L stirbt rund bei `Kurs * (1 - 1/L)`, eine
       Short bei `Kurs * (1 + 1/L)`. Die Erhaltungsmarge ist dabei
       **weggelassen** -- sie schoebe die Schwelle ein Stueck naeher an den
       Einstieg, und sie ist je Boerse und Groesse verschieden.
    3. **Ein Niveau lebt, bis der Kurs es durchschreitet.** Danach ist es
       abgeraeumt und verschwindet -- daher brechen die Baender im Bild dort
       ab, wo der Kurs war.

    Zurueck kommt ein duennes Gitter: nur Zellen ueber `schwelle` mal dem
    hoechsten Wert. Voll waeren es 64 mal 400 Zahlen, und die meisten sind
    null.
    """
    if len(kerzen) < 3:
        return {"yAxis": [], "cells": [], "max": 0}
    tief = min(k[3] for k in kerzen)
    hoch = max(k[2] for k in kerzen)
    spanne = hoch - tief
    if spanne <= 0:
        return {"yAxis": [], "cells": [], "max": 0}
    # Etwas Luft, damit die Baender knapp ausserhalb der Kurspanne noch
    # hineinpassen -- dort liegen die interessanten.
    tief -= spanne * 0.04
    hoch += spanne * 0.04
    breite = (hoch - tief) / stufen
    n = len(kerzen)

    zeiten = sorted(offenes_interesse(_oi_raster_fuer(kerzen)))
    werte = offenes_interesse(_oi_raster_fuer(kerzen))
    if len(zeiten) < 3:
        return {"yAxis": [], "cells": [], "max": 0, "kein_oi": True}

    def oi_bei(ts):
        # Der letzte Punkt, der nicht nach `ts` liegt
        links, rechts = 0, len(zeiten) - 1
        if ts < zeiten[0]:
            return None
        while links < rechts:
            mitte = (links + rechts + 1) // 2
            if zeiten[mitte] <= ts:
                links = mitte
            else:
                rechts = mitte - 1
        return werte[zeiten[links]]

    gitter = [[0.0] * stufen for _ in range(n)]
    vorher = oi_bei(kerzen[0][0])
    hoechst = 0.0
    for i in range(1, n):
        jetzt = oi_bei(kerzen[i][0])
        if jetzt is None or vorher is None:
            vorher = jetzt
            continue
        zuwachs = jetzt - vorher
        vorher = jetzt
        if zuwachs <= 0:
            continue
        preis = kerzen[i][4]
        wert = zuwachs * preis
        for hebel, anteil in HEBEL_STUFEN:
            for ist_long in (True, False):
                teil = wert * anteil * (LONG_ANTEIL if ist_long
                                        else 1.0 - LONG_ANTEIL)
                niveau = preis * (1.0 - 1.0 / hebel) if ist_long \
                    else preis * (1.0 + 1.0 / hebel)
                if niveau < tief or niveau >= hoch:
                    continue
                y = int((niveau - tief) / breite)
                for j in range(i, n):
                    if kerzen[j][3] <= niveau <= kerzen[j][2]:
                        break
                    gitter[j][y] += teil
                    if gitter[j][y] > hoechst:
                        hoechst = gitter[j][y]
    grenze = hoechst * schwelle
    zellen = []
    for x in range(n):
        for y in range(stufen):
            if gitter[x][y] > grenze:
                zellen.append([x, y, round(gitter[x][y])])
    return {"yAxis": [round(tief + (y + 0.5) * breite, 2) for y in range(stufen)],
            "cells": zellen, "max": round(hoechst)}


def _oi_raster_fuer(kerzen):
    """Das Raster des offenen Interesses, das zu den Kerzen passt."""
    if len(kerzen) < 2:
        return "1h"
    schritt = kerzen[1][0] - kerzen[0][0]
    for name, laenge in OI_RASTER:
        if laenge >= schritt:
            return name
    return "1d"


def markt_kurs(feed, cur):
    """Umrechnungsfaktor von Dollar in `cur`.

    **Die Boerse rechnet in USDT, nicht in Dollar** -- der Unterschied liegt
    im Promillebereich und wird hier ignoriert; alles andere waere eine
    Genauigkeit, die die Daten nicht hergeben.

    Der Faktor kommt aus dem laufenden Kurs, den mempool.space in sieben
    Waehrungen mitschickt: `price[cur] / price[usd]`. Das ist der **heutige**
    Kurs, auch fuer Kerzen von 2017 -- fuer einen Verlauf ueber Jahre ist das
    eine Umrechnung, keine Wahrheit. Die Antwort sagt es mit `converted`.
    """
    cur = (cur or "usd").lower()
    if cur == "usd":
        return 1.0, False
    p = feed.price or {}
    if p.get(cur) and p.get("usd"):
        return float(p[cur]) / float(p["usd"]), True
    # Ersatzweise die Kurse aus dem Verlauf -- sie liegen ohnehin im Puffer
    kurse = (price_history().get("rates") or {})
    k = kurse.get("USD" + cur.upper())
    return (float(k), True) if k else (1.0, False)


def run_market(quelle):
    """Ein Faden je Boerse. Verbindet erst, wenn jemand hinsieht."""
    backoff = 2
    while True:
        if not MARKT.erwuenscht():
            MARKT.online[quelle["id"]] = False
            time.sleep(2)
            continue
        ws = None
        try:
            ws = WebSocket(quelle["url"], timeout=30)
            if quelle["sub"]:
                ws.send(json.dumps(quelle["sub"]))
            MARKT.online[quelle["id"]] = True
            backoff = 2
            while MARKT.erwuenscht():
                raw = ws.recv()
                if raw is None:
                    continue
                try:
                    msg = json.loads(raw)
                except ValueError:
                    continue
                for ts, preis, menge, kauf in quelle["parse"](msg):
                    MARKT.add(ts, preis, menge, kauf, quelle["id"])
        except Exception as e:
            MARKT.online[quelle["id"]] = False
            sys.stderr.write("Markt %s: %s\n" % (quelle["id"], e))
            time.sleep(backoff)
            backoff = min(60, backoff * 2)
        finally:
            if ws is not None:
                try:
                    ws.close()
                except Exception:
                    pass


# --------------------------------------------------------------------------
# Kursverlauf
# --------------------------------------------------------------------------
_price_lock = threading.Lock()
_prices = {"ts": 0, "points": [], "rates": {}}

# Zeitraeume, die die Oberflaeche anbietet. 0 heisst: alles, was da ist.
SPANS = {"24h": 86400, "7d": 604800, "30d": 2592000,
         "90d": 7776000, "1y": 31536000, "max": 0}


def fetch_prices():
    """Den Verlauf holen und als Zahlenfelder ablegen.

    Aus `[{"time": t, "EUR": e, "USD": u}, ...]` wird `[[t, e, u], ...]` --
    dieselben Zahlen, aber ohne die Schluessel bei jedem Punkt. Das halbiert
    die Datei und spart beim Lesen den Umweg ueber Woerterbuecher.
    """
    d = http_json("/v1/historical-price?currency=EUR", timeout=60)
    punkte = []
    for x in d.get("prices") or []:
        t = x.get("time")
        e, u = x.get("EUR") or 0, x.get("USD") or 0
        # **-1 heisst "kein Wert".** 295 der 33.299 Punkte tragen ihn, meist
        # im EUR-Feld bei gueltigem USD-Feld. Ungefiltert zieht eine einzige
        # -1 die ganze Kurve nach unten: der Tiefstwert stand bei -1 Euro und
        # die Veraenderung ueber den Gesamtzeitraum bei -6.966.100 %.
        e = e if e > 0 else 0
        u = u if u > 0 else 0
        if t and (e or u):
            punkte.append([int(t), round(e, 2), round(u, 2)])
    punkte.sort(key=lambda x: x[0])
    return {"ts": time.time(), "points": punkte,
            "rates": d.get("exchangeRates") or {}}


def price_history():
    """Der Verlauf, aus dem Speicher, von der Platte oder frisch geholt."""
    with _price_lock:
        jung = time.time() - _prices["ts"] < PRICE_MAX_AGE
        if _prices["points"] and jung:
            return _prices
        if not _prices["points"]:
            try:
                with open(PRICE_FILE) as f:
                    d = json.load(f)
                if d.get("points"):
                    _prices.update(d)
                    jung = time.time() - _prices["ts"] < PRICE_MAX_AGE
            except (OSError, ValueError):
                pass
        if not jung:
            try:
                d = fetch_prices()
            except Exception as e:
                # Ein alter Verlauf ist besser als gar keiner: nur der obere
                # Rand fehlt, und den fuellt der laufende Kurs.
                sys.stderr.write("Kursverlauf nicht erreichbar: %s\n" % e)
                return _prices
            _prices.update(d)
            try:
                os.makedirs(CACHE_DIR, exist_ok=True)
                tmp = PRICE_FILE + ".tmp"
                with open(tmp, "w") as f:
                    json.dump(_prices, f, separators=(",", ":"))
                os.replace(tmp, PRICE_FILE)
            except OSError as e:
                sys.stderr.write("Kursverlauf nicht zu sichern: %s\n" % e)
        return _prices


def price_series(span, cur):
    """Ein Zeitraum, ausgeduennt und in der gewuenschten Waehrung.

    **Nur EUR und USD stehen wirklich im Datensatz.** Die uebrigen fuenf
    entstehen aus dem USD-Wert mit dem *heutigen* Wechselkurs -- fuer einen
    Verlauf ueber Jahre ist das nicht die Wahrheit, sondern eine Umrechnung.
    Die Antwort sagt das mit `umgerechnet`, damit die Oberflaeche es
    dazuschreiben kann.
    """
    d = price_history()
    punkte = d["points"]
    cur = (cur or "usd").lower()
    dauer = SPANS.get(span, 0)
    if dauer:
        grenze = time.time() - dauer
        punkte = [p for p in punkte if p[0] >= grenze]
    if not punkte:
        return {"span": span, "cur": cur, "points": [], "converted": False}

    # **Erst die Waehrung, dann ausduennen.** Andersherum faellt ein ganzes
    # Fach aus, wenn ausgerechnet der gewaehlte Punkt in dieser Waehrung keinen
    # Wert hat -- und das sind bei EUR fast dreihundert.
    umgerechnet = cur not in ("eur", "usd")
    if not umgerechnet:
        i = 1 if cur == "eur" else 2
        reihe = [[p[0], p[i]] for p in punkte if p[i] > 0]
    else:
        kurs = (d["rates"] or {}).get("USD" + cur.upper())
        if not kurs:
            return {"span": span, "cur": cur, "points": [], "converted": True}
        reihe = [[p[0], round(p[2] * kurs, 2)] for p in punkte if p[2] > 0]
    if not reihe:
        return {"span": span, "cur": cur, "points": [], "converted": umgerechnet}

    # Ausduennen: der Zeitraum wird in gleich breite Faecher geteilt, aus jedem
    # kommt ein Punkt. **Nicht jeder n-te Punkt** -- die Abstaende sind
    # ungleich (stuendlich, taeglich, woechentlich), und dann verzerrt jede
    # feste Schrittweite die Zeitachse.
    if len(reihe) > PRICE_POINTS:
        t0, t1 = reihe[0][0], reihe[-1][0]
        breite = max(1, (t1 - t0) / PRICE_POINTS)
        gewaehlt, letztes = [], -1
        for p in reihe:
            fach = int((p[0] - t0) / breite)
            if fach != letztes:
                gewaehlt.append(p)
                letztes = fach
        if gewaehlt[-1][0] != reihe[-1][0]:
            gewaehlt.append(reihe[-1])
        reihe = gewaehlt

    return {"span": span, "cur": cur, "points": reihe,
            "converted": umgerechnet,
            "ts": round(d["ts"], 2)}


# --------------------------------------------------------------------------
# Das Netz: Hashrate, Schwierigkeit, Pools
# --------------------------------------------------------------------------
# Fuer den Reiter "Netz" in der Miner-Ansicht. **Nicht im Zustand**, aus
# demselben Grund wie der Kursverlauf: der wird 2,5-mal je Sekunde geholt,
# diese Reihen aendern sich einmal am Tag. Sie kommen nur, wenn jemand den
# Reiter offen hat.
#
# Die Zeitraeume heissen wie beim Kurs, damit beide Graphen dieselben Knoepfe
# haben. Dahinter stehen die Namen von mempool.space. 24 Stunden und sieben
# Tage gibt es nicht: die Reihe hat einen Punkt am Tag, das waeren einer und
# sieben.
NET_SPANS = {"30d": "1m", "90d": "3m", "1y": "1y", "3y": "3y", "max": "all"}
# Gemessen am 11.09.2026: 1m 2,2 kB, 1y 25 kB, 3y 75 kB, all 428 kB.
NET_TTL = {"max": 6 * 3600}
NET_TTL_DEFAULT = 3600
POOLS_TTL = 1800
_net_lock = threading.Lock()
_net_cache = {}     # Zeitraum -> (Zeitpunkt, Antwort)


def _duennen_mittel(reihe, anzahl):
    """Auf hoechstens `anzahl` Punkte, je Fach **der Mittelwert**.

    Beim Kurs wird aus jedem Fach ein Punkt genommen; dort ist jeder Punkt
    ein echter Kurs. Die Hashrate ist dagegen schon eine Schaetzung aus den
    Bloecken eines Tages und springt von Tag zu Tag um zehn, zwanzig Prozent.
    Ein herausgegriffener Tag wuerde zufaellig hoch oder tief liegen, das
    Mittel zeigt den Gang. Die Zeit eines Fachs ist ebenso das Mittel seiner
    Tage."""
    if len(reihe) <= anzahl:
        return reihe
    t0, t1 = reihe[0][0], reihe[-1][0]
    breite = max(1, (t1 - t0) / anzahl)
    out, fach, summe, zeiten, n = [], None, 0.0, 0, 0
    for t, v in reihe:
        f = int((t - t0) / breite)
        if f != fach and n:
            out.append([round(zeiten / n), summe / n])
            summe, zeiten, n = 0.0, 0, 0
        fach = f
        summe += v
        zeiten += t
        n += 1
    if n:
        out.append([round(zeiten / n), summe / n])
    return out


def _pools_holen():
    """Anteile der Pools an den Bloecken der letzten Woche.

    Eine Woche, weil ein Tag mit 144 Bloecken bei den kleinen Pools nur
    Zufall zeigt, und ein Monat den Wechsel eines grossen Pools verschleppt.
    Der Zeitraum steht in der Antwort; die Oberflaeche schreibt ihn dazu."""
    with _net_lock:
        hit = _net_cache.get("pools")
        if hit and time.time() - hit[0] < POOLS_TTL:
            return hit[1]
    try:
        d = http_json("/v1/mining/pools/1w")
    except Exception as e:
        sys.stderr.write("Pools: %s\n" % e)
        return hit[1] if hit else None
    liste = [{"name": p.get("name") or "",
              "slug": p.get("slug") or "",
              "blocks": int(p.get("blockCount") or 0)}
             for p in (d.get("pools") or [])]
    liste.sort(key=lambda p: -p["blocks"])
    pools = {"span": "1w", "blockCount": int(d.get("blockCount") or 0),
             "list": liste}
    with _net_lock:
        _net_cache["pools"] = (time.time(), pools)
    return pools


def network_series(span):
    """Hashrate und Schwierigkeit ueber einen Zeitraum, dazu die Pools.

        hashrate    [[Zeit, H/s], ...], hoechstens PRICE_POINTS Punkte
        difficulty  [[Zeit, Schwierigkeit, Hoehe, Faktor], ...] -- jede
                    Anpassung im Zeitraum. Der Faktor ist das Verhaeltnis
                    zur vorigen; damit laesst sich die Treppe am linken Rand
                    mit dem Wert **vor** der ersten Anpassung beginnen.

    Scheitert die Abfrage, kommt der letzte Stand -- ein Verlauf von gestern
    ist besser als gar keiner."""
    if span not in NET_SPANS:
        span = "1y"
    ttl = NET_TTL.get(span, NET_TTL_DEFAULT)
    with _net_lock:
        hit = _net_cache.get(span)
    if hit and time.time() - hit[0] < ttl:
        d = dict(hit[1])
    else:
        try:
            roh = http_json("/v1/mining/hashrate/" + NET_SPANS[span], timeout=30)
            reihe = [[int(p.get("timestamp") or 0), float(p.get("avgHashrate") or 0)]
                     for p in (roh.get("hashrates") or [])]
            # Die ersten Tage von 2009 tragen 0 -- auf einer linearen Achse
            # stoert das nicht, es gibt aber keinen Wert, der dort zu lesen
            # waere.
            reihe = [p for p in reihe if p[0] and p[1] > 0]
            stufen = [[int(x.get("time") or 0), float(x.get("difficulty") or 0),
                       int(x.get("height") or 0),
                       round(float(x.get("adjustment") or 1), 6)]
                      for x in (roh.get("difficulty") or [])]
            d = {
                "span": span,
                "hashrate": [[t, round(v)] for t, v in
                             _duennen_mittel(reihe, PRICE_POINTS)],
                "difficulty": [s for s in stufen if s[0] and s[1] > 0],
                "current": roh.get("currentHashrate"),
                "currentDifficulty": roh.get("currentDifficulty"),
                "ts": round(time.time(), 2),
            }
            with _net_lock:
                _net_cache[span] = (time.time(), d)
            d = dict(d)
        except Exception as e:
            sys.stderr.write("Netz-Hashrate (%s): %s\n" % (span, e))
            if not hit:
                return {"span": span, "hashrate": [], "difficulty": [],
                        "pools": _pools_holen(), "error": str(e)}
            d = dict(hit[1])
    d["pools"] = _pools_holen()
    return d


