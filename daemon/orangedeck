def liq_nachholen():
    """Den letzten Tag von OKX per REST, wie `__nachholen` in DirectMarket.qml.

    Der Dienst hoert nur zu, solange jemand den Markt ansieht. Wer morgens
    oeffnet, sah bis zum 15.09.2026 die Nacht als Luecke, obwohl OKX sie
    liefern kann: `liquidation-orders` gibt es auch per REST, blaetternd mit
    `after`, gemessen rund 23 Stunden. Die Antwort hat dieselbe Form wie der
    Strom, also derselbe Parser. Doppeltes faengt die Sperre in `LIQ.add`.

    Hoechstens alle fuenf Minuten und nie zweimal gleichzeitig -- es wird bei
    jedem Verbinden des OKX-Stroms angestossen, und der verbindet nach einem
    Abbruch neu.
    """
    if not _liq_nachholen_lock.acquire(blocking=False):
        return
    try:
        if time.time() - _liq_nachgeholt[0] < 300:
            return
        _liq_nachgeholt[0] = time.time()
        basis = ("https://www.okx.com/api/v5/public/liquidation-orders"
                 "?instType=SWAP&instFamily=BTC-USDT&state=filled&limit=100")
        nach = 0
        aeltest_gesamt = 0.0
        # **Bis OKX leer antwortet, nicht eine feste Seitenzahl.** Gemessen am
        # 16.09.2026: OKX liefert per REST genau 24 Stunden, danach leere
        # Seiten -- an diesem Tag nach 20 Seiten (1874 Marken, 9,7 s). Am
        # 15.09. reichten 30 Seiten nur fuer 16,6 Stunden, vorher 10 fuer
        # 16,5. Die 100 sind nur noch Schutz gegen eine Schleife; sie decken
        # auch einen Tag mit dem Dreifachen des 15.09. Gleiche Grenze wie in
        # DirectMarket.qml.
        for _seite in range(100):
            try:
                d = _hol_json(basis + ("&after=%d" % nach if nach else ""), timeout=15)
            except Exception as e:
                sys.stderr.write("Liquidationen nachholen: %s\n" % e)
                break
            if str(d.get("code")) != "0":
                break
            aeltest = 0.0
            for ts, preis, menge, ist_long in _okx_liquidationen(
                    {"arg": {"channel": "liquidation-orders"}, "data": d.get("data")}):
                LIQ.add(ts, preis, menge, ist_long, "okx")
                if not aeltest or ts < aeltest:
                    aeltest = ts
            if not aeltest:
                break
            aeltest_gesamt = aeltest
            ms = int(aeltest * 1000)
            if nach and ms >= nach:
                break
            nach = ms
        LIQ.ordnen()
        # `seit` ist die Grenze, vor der sicher nichts liegt. Mit dem
        # Rueckgriff rueckt sie zurueck, nie vor.
        if aeltest_gesamt and (not LIQ.seit or aeltest_gesamt < LIQ.seit):
            LIQ.seit = aeltest_gesamt
    finally:
        _liq_nachholen_lock.release()


def run_liquidationen(quelle):
    """Ein Faden je Quelle. Wie `run_market`, aber **mit Ping**.

    Der Unterschied ist wesentlich: ein Handelsstrom traegt sich durch seinen
    eigenen Verkehr, ein Liquidationsstrom ist minutenlang still. Bybit trennt
    eine untaetige Verbindung, und ohne Ping merkt man das nicht einmal -- die
    Leseschleife laeuft dann ins Nichts. Genau darauf ist der erste Versuch
    hier hereingefallen: fuenf Minuten "keine Liquidation", in Wahrheit war
    die Verbindung nach dreissig Sekunden weg.
    """
    backoff = 2
    while True:
        if not MARKT.erwuenscht():
            LIQ.online[quelle["id"]] = False
            time.sleep(2)
            continue
        ws = None
        try:
            ws = WebSocket(quelle["url"], timeout=10)
            if quelle["sub"]:
                ws.send(json.dumps(quelle["sub"]))
            LIQ.online[quelle["id"]] = True
            if not LIQ.seit:
                LIQ.seit = time.time()
            if quelle["id"] == "okx":
                threading.Thread(target=liq_nachholen, daemon=True).start()
            backoff = 2
            letzter_ping = time.time()
            while MARKT.erwuenscht():
                if time.time() - letzter_ping > quelle["pingtakt"]:
                    ws.send(quelle["ping"])
                    letzter_ping = time.time()
                try:
                    raw = ws.recv()
                except socket.timeout:
                    # Stille ist hier der Regelfall, kein Fehler
                    continue
                if raw is None:
                    continue
                try:
                    msg = json.loads(raw)
                except ValueError:
                    continue
                for ts, preis, menge, ist_long in quelle["parse"](msg):
                    LIQ.add(ts, preis, menge, ist_long, quelle["id"])
        except Exception as e:
            LIQ.online[quelle["id"]] = False
            sys.stderr.write("Liquidationen %s: %s\n" % (quelle["id"], e))
            time.sleep(backoff)
            backoff = min(60, backoff * 2)
        finally:
            if ws is not None:
                try:
                    ws.close()
                except Exception:
                    pass


# Fuer einen selbst gewaehlten Zeitraum wird das Raster gesucht, das etwa
# zweihundert Kerzen ergibt -- die Leiter ist die von Binance.
KLINE_LADDER = (("1m", 60), ("3m", 180), ("5m", 300), ("15m", 900),
                ("30m", 1800), ("1h", 3600), ("2h", 7200), ("4h", 14400),
                ("6h", 21600), ("12h", 43200), ("1d", 86400),
                ("3d", 259200), ("1w", 604800))


def raster_fuer(sekunden):
    """Raster und Anzahl fuer einen beliebigen Zeitraum."""
    ziel = 200
    for name, laenge in KLINE_LADDER:
        if sekunden / laenge <= 400:
            anzahl = max(20, min(1000, int(round(sekunden / laenge))))
            return name, anzahl
    return "1w", 1000


_klines_lock = threading.Lock()
_klines = {}   # (raster, anzahl) -> (zeitpunkt, kerzen)


def klines(spanne, symbol="BTCUSDT", von=0, bis=0):
    """Fertige Kerzen der Boerse fuer einen Zeitraum.

    Ohne `von`/`bis` endet das Fenster **jetzt** -- das ist der Regelfall. Mit
    beiden wird ein Fenster in der Vergangenheit geholt; das Raster sucht sich
    dann nach dessen Laenge, damit auch dort rund zweihundert Kerzen
    herauskommen.

    Gepuffert je Raster und Fenster: ein Tagesraster muss nicht alle zwei
    Sekunden neu geholt werden, ein Minutenraster schon eher. **Ein Fenster in
    der Vergangenheit aendert sich gar nicht mehr** und wird deshalb lange
    gehalten. Faellt die Boerse aus, kommt der letzte Stand zurueck -- ein
    alter Kurs ist besser als ein leeres Bild.
    """
    if von and bis and bis > von:
        raster, anzahl = raster_fuer(bis - von)
    elif isinstance(spanne, tuple):
        raster, anzahl = spanne
    else:
        raster, anzahl = KLINE_SPANS.get(spanne, KLINE_SPANS["24h"])
    schluessel = (symbol, raster, anzahl, von, bis)
    # Vergangenes ist abgeschlossen -- eine Stunde Puffer schadet dort nicht.
    ttl = 3600 if bis and bis < time.time() - 120 else KLINE_CACHE_TTL.get(raster, 60)
    with _klines_lock:
        eintrag = _klines.get(schluessel)
        if eintrag and time.time() - eintrag[0] < ttl:
            return eintrag[1]
    try:
        url = ("https://api.binance.com/api/v3/klines?symbol=%s&interval=%s&limit=%d"
               % (symbol, raster, min(1000, anzahl)))
        if von and bis and bis > von:
            url += "&startTime=%d&endTime=%d" % (int(von) * 1000, int(bis) * 1000)
        elif bis:
            url += "&endTime=%d" % (int(bis) * 1000)
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=20) as r:
            roh = json.loads(r.read().decode())
    except Exception as e:
        sys.stderr.write("Kerzen %s: %s\n" % (spanne, e))
        with _klines_lock:
            eintrag = _klines.get(schluessel)
        return eintrag[1] if eintrag else []
    aus = []
    for k in roh:
        try:
            # [Oeffnungszeit, O, H, L, C, Volumen, Schluss, Umsatz, Trades,
            #  Kaufvolumen, ...]. Feld 9 ist das Volumen der Trades, die in
            # den Brief gegangen sind -- gekauft; der Rest ist verkauft.
            # **Damit steht der Kauf-Verkauf-Unterschied fuer jeden Zeitraum
            # zur Verfuegung**, nicht nur fuer die Sekundenfaecher der letzten
            # Stunde. Der CVD haengt daran.
            volumen = float(k[5])
            kauf = float(k[9])
            aus.append([int(k[0]) // 1000, round(float(k[1]), 2),
                        round(float(k[2]), 2), round(float(k[3]), 2),
                        round(float(k[4]), 2), round(kauf, 3),
                        round(max(0.0, volumen - kauf), 3)])
        except (IndexError, TypeError, ValueError):
            continue
    with _klines_lock:
        _klines[schluessel] = (time.time(), aus)
    return aus


_uebersicht_lock = threading.Lock()
_uebersicht = (0.0, [])


def uebersicht():
    """Tageskerzen der **ganzen** Geschichte, am Stueck.

    Wofuer: der Schieber der Zeitachse spannt neun Jahre auf eine Leiste. Ein
    Zug von zehn Bildpunkten sind dort schnell hundert Tage, und jede Stelle
    waere ein eigenes Fenster -- **gemessen 1,1 bis 1,5 Sekunden**, weil dafuer
    bei Binance nachgefragt wird. Beim Ziehen ist das unbrauchbar.

    Deshalb liegt die ganze Geschichte einmal grob vor: rund 3.300 Tageskerzen,
    etwa 270 kB. Die Oberflaeche haelt sie und zeichnet daraus **waehrend** des
    Ziehens sofort -- gob, aber sofort und ueberall. Das genaue Fenster kommt,
    wenn die Hand loslaesst.

    Binance gibt hoechstens 1000 Kerzen je Abfrage, also vier Seiten. Ein Tag
    aendert sich nur an seinem Ende; eine halbe Stunde Puffer reicht.
    """
    global _uebersicht
    with _uebersicht_lock:
        wann, daten = _uebersicht
        if daten and time.time() - wann < 1800:
            return daten
    aus = []
    start = 1501459200          # 31.07.2017, der erste Handelstag
    jetzt = int(time.time())
    try:
        while start < jetzt and len(aus) < 6000:
            url = ("https://api.binance.com/api/v3/klines?symbol=BTCUSDT"
                   "&interval=1d&limit=1000&startTime=%d" % (start * 1000))
            req = urllib.request.Request(url, headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=30) as r:
                seite = json.loads(r.read().decode())
            if not seite:
                break
            for k in seite:
                try:
                    volumen = float(k[5])
                    kauf = float(k[9])
                    aus.append([int(k[0]) // 1000, round(float(k[1]), 2),
                                round(float(k[2]), 2), round(float(k[3]), 2),
                                round(float(k[4]), 2), round(kauf, 3),
                                round(max(0.0, volumen - kauf), 3)])
                except (IndexError, TypeError, ValueError):
                    continue
            # Die naechste Seite beginnt einen Tag nach der letzten Kerze --
            # ohne das schickt Binance dieselbe Seite noch einmal.
            weiter = int(seite[-1][0]) // 1000 + 86400
            if weiter <= start:
                break
            start = weiter
    except Exception as e:
        sys.stderr.write("Uebersicht: %s\n" % e)
        with _uebersicht_lock:
            _wann, alt = _uebersicht
        # Ein alter Stand ist besser als ein leeres Bild
        return alt if alt else []
    with _uebersicht_lock:
        _uebersicht = (time.time(), aus)
    return aus


