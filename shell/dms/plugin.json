{
    "id": "orangedeck",
    "name": "OrangeDeck Bitcoin Dashboard",
    "description": "Bitcoin mempool, blocks, miners and market on the desktop",
    "version": "1.3.1",
    "author": "Satoshoe",
    "type": "composite",
    "capabilities": ["daemon", "dankbar-widget", "control-center", "desktop-widget"],
    "icon": "currency_bitcoin",
    "components": {
        "daemon": "./OrangeDeckDaemon.qml",
        "widget": "./OrangeDeckWidget.qml",
        "desktop": "./OrangeDeckDesktop.qml"
    },
    "settings": "./OrangeDeckSettings.qml",
    "requires_dms": ">=1.5.0",
    "permissions": ["settings_read", "settings_write"]
}
